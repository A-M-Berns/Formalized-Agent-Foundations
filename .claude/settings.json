{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/seed-worktree-caches.sh",
            "timeout": 600,
            "statusMessage": "Seeding Lean build caches into worktree..."
          }
        ]
      }
    ]
  }
}
