/-
# Feedback and pseudorandomness infrastructure

This file develops the `wubaff`/`prandaff` dependency tranche without weakening the
paper's quantifiers.  In particular, `DeferralPatient` is the paper's bounded-window
condition, not the stronger and easier condition “all divergent weightings”.  It builds
the market-generated patient-capacity selector used by `thm:prandaff`, specializes that
theorem to the rational varied-frequency `thm:prand`, and proves fixed-frequency
`thm:benford` for an arbitrary real frequency by the paper's rational squeeze.

The remaining operational boundaries are deliberately visible as settlement clocks and
historical verifier constructors.  They contain no selector divergence, price bound,
bias, pseudorandomness, or learning conclusion.
-/
import LogicalInduction.Properties.Calibration
import LogicalInduction.Properties.SelfTrust
import Mathlib.Analysis.SpecialFunctions.Log.Basic

namespace LogicalInduction

open Filter Topology Set

namespace AffineCombination

/-- The constant rational feature used by the rational squeeze in `thm:benford`.
Unlike an arbitrary rational sequence, this feature is visibly market-generable: its
syntax is one closed constant token and its denotation is independent of the market. -/
def constantRatFeature (q : ℚ) (_n : ℕ) : EF := EF.const q

lemma constantRatFeature_generated (P : History) (q : ℚ) :
    GeneratedRatFeature P (fun _ ↦ q) (constantRatFeature q) where
  rank_le := by intro n; simp [constantRatFeature]
  polyTok := PolyTokenStream.serialize_const q
  closed := by intro n ρ V; simp [constantRatFeature]
  denote := by intro n; simp [constantRatFeature]

/-- Centered sentence affine family `φₙ - pₙ` when the rational target is generated by
an actual market feature rather than by an independently computable rational code. -/
def sentenceMinusFeature (φ : ℕ → Sentence) (pFeature : ℕ → EF) (n : ℕ) :
    AffineCombination where
  const := EF.mul (EF.const (-1)) (pFeature n)
  terms := [(EF.const 1, φ n)]

@[simp] theorem sentenceMinusFeature_value (φ : ℕ → Sentence)
    (pFeature : ℕ → EF) (n : ℕ) (V : History) (v : Valuation) :
    (sentenceMinusFeature φ pFeature n).value V v =
      v (φ n) - (pFeature n).denote V := by
  simp [sentenceMinusFeature, value]
  ring

@[simp] theorem sentenceMinusFeature_price (φ : ℕ → Sentence)
    (pFeature : ℕ → EF) (P : History) (n m : ℕ) :
    (sentenceMinusFeature φ pFeature n).price P m =
      P m (φ n) - (pFeature n).denote P := by
  simp [price]

@[simp] theorem sentenceMinusFeature_magnitude (φ : ℕ → Sentence)
    (pFeature : ℕ → EF) (P : History) (n : ℕ) :
    (sentenceMinusFeature φ pFeature n).magnitude P = 1 := by
  simp [sentenceMinusFeature, magnitude]

noncomputable def sentenceMinusFeature_polySequence
    (φ : ℕ → Sentence) (pFeature : ℕ → EF)
    (hφ : PolySentenceCodes φ) {P : History} {p : ℕ → ℚ}
    (hp : GeneratedRatFeature P p pFeature) :
    PolySequence (sentenceMinusFeature φ pFeature) := by
  let cφ := Classical.choose hφ
  have hcφ := Classical.choose_spec hφ
  exact {
    termCount := fun _ ↦ 1
    coefficient := fun _ ↦ EF.const 1
    sentence := fun z ↦ φ z.unpair.1
    termCount_poly := ⟨Nat.Partrec.Code.const 1, PolyFueled.const 1⟩
    const_poly := PolySegStream.serialize_mul
      (PolySegStream.ofTokenStream (PolyTokenStream.serialize_const (-1)))
      (PolySegStream.ofTokenStream hp.polyTok)
    coefficient_poly :=
      PolySegStream.ofTokenStream (PolyTokenStream.serialize_const 1)
    sentence_poly := ⟨cφ.comp Nat.Partrec.Code.left, hcφ.comp PolyFueled.left⟩
    terms_eq := by intro n; simp [sentenceMinusFeature]
    const_rank := by
      intro n
      simp only [sentenceMinusFeature, EF.rank]
      exact hp.rank_le n
    coefficient_rank := by intro n j hj; simp [EF.rank]
    const_closed := by
      intro n ρ V
      simp only [sentenceMinusFeature, EF.denoteWith, EF.denote_mul,
        Pi.mul_apply, EF.denote_const]
      rw [hp.closed n ρ V]
    coefficient_closed := by intro z ρ V; simp [EF.denoteWith]
  }

lemma sentenceMinusFeature_bounded
    (φ : ℕ → Sentence) (pFeature : ℕ → EF)
    {P : History} {p : ℕ → ℚ} (hp : GeneratedRatFeature P p pFeature)
    (hP : ∀ n ψ, 0 ≤ P n ψ ∧ P n ψ ≤ 1)
    (hpProb : ∀ n, 0 ≤ (p n : ℝ) ∧ (p n : ℝ) ≤ 1) :
    BoundedAffinePrices (sentenceMinusFeature φ pFeature) P := by
  refine ⟨1, zero_le_one, fun n m ↦ ?_⟩
  rw [sentenceMinusFeature_price, hp.denote n, abs_le]
  constructor <;>
    linarith [(hP m (φ n)).1, (hP m (φ n)).2,
      (hpProb n).1, (hpProb n).2]

end AffineCombination

/-- A realized weighting is **`f`-patient** when the total weight in every inclusive
deferral window `[n, f n]` has one uniform finite bound.  This is exactly the definition
preceding `thm:prand` in the paper. -/
def DeferralPatient (f : DeferralFunction) (W : ℕ → EF) (P : History) : Prop :=
  ∃ C : ℝ, ∀ n,
    ∑ i ∈ Finset.Icc n (f n), (W i).denote P ≤ C

/-- The extra schedule condition in `thm:wubaff`: supported predictions occur in a
strict temporal order, so the outcome of component `f k` is available by `f (k+1)` before
the next supported bet.  Plain `DeferralFunction` intentionally does not imply this. -/
def StrictlyIncreasingDeferral (f : DeferralFunction) : Prop := StrictMono f

/-- Exact support-in-image premise of `thm:wubaff`.  It is stated using nonzero realized
weight, matching mathematical support; `DivergentWeighting` later makes every such weight
nonnegative. -/
def WeightingSupportedOnDeferralImage
    (W : ℕ → EF) (P : History) (f : DeferralFunction) : Prop :=
  ∀ n, (W n).denote P ≠ 0 → ∃ k, f k = n

lemma StrictlyIncreasingDeferral.injective {f : DeferralFunction}
    (h : StrictlyIncreasingDeferral f) : Function.Injective f :=
  StrictMono.injective h

lemma weightedAverage_neg (w x : ℕ → ℝ) {n : ℕ}
    (hden : prefixSum w n ≠ 0) :
    weightedAverage w (fun i ↦ -x i) n = -weightedAverage w x n := by
  have hnum : prefixSum (fun i ↦ w i * -x i) n =
      -prefixSum (fun i ↦ w i * x i) n := by
    change (∑ i ∈ Finset.range (n + 1), w i * -x i) =
      -(∑ i ∈ Finset.range (n + 1), w i * x i)
    rw [← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [weightedAverage_eq_div hden, weightedAverage_eq_div hden, hnum]
  ring

lemma weightedAverage_const (w : ℕ → ℝ) (c : ℝ) {n : ℕ}
    (hden : prefixSum w n ≠ 0) :
    weightedAverage w (fun _ ↦ c) n = c := by
  rw [weightedAverage_eq_div hden]
  have hnum : prefixSum (fun i ↦ w i * c) n = prefixSum w n * c := by
    simp only [prefixSum, Finset.sum_mul]
  rw [hnum]
  field_simp

/-- Pseudorandom nonnegativity of a determined stream against every legal patient
market-generated divergent weighting.  This is the hypothesis of the `≳ₙ 0` branch of
`thm:prandaff`, factored from the affine syntax whose completed-theory value it describes. -/
def PseudorandomAbove (truth : ℕ → ℝ) (f : DeferralFunction) (P : History) : Prop :=
  ∀ (W : ℕ → EF), PGenerableWeighting W → DivergentWeighting W P →
    DeferralPatient f W P →
      (weightedAverage (fun i ↦ (W i).denote P) truth) ≳ₙ (fun _ ↦ 0)

/-- The `≲ₙ 0` branch of affine pseudorandomness. -/
def PseudorandomBelow (truth : ℕ → ℝ) (f : DeferralFunction) (P : History) : Prop :=
  ∀ (W : ℕ → EF), PGenerableWeighting W → DivergentWeighting W P →
    DeferralPatient f W P →
      (weightedAverage (fun i ↦ (W i).denote P) truth) ≲ₙ (fun _ ↦ 0)

/-- Two-sided affine pseudorandomness. -/
def Pseudorandom (truth : ℕ → ℝ) (f : DeferralFunction) (P : History) : Prop :=
  PseudorandomAbove truth f P ∧ PseudorandomBelow truth f P

/-- Positive rescaling preserves pseudorandom nonnegativity. -/
lemma PseudorandomAbove.const_mul_pos
    {truth : ℕ → ℝ} {f : DeferralFunction} {P : History}
    (h : PseudorandomAbove truth f P) {c : ℝ} (hc : 0 < c) :
    PseudorandomAbove (fun n => c * truth n) f P := by
  intro W hWgen hWdiv hpatient ε hε
  have hbase := h W hWgen hWdiv hpatient (ε / c) (div_pos hε hc)
  filter_upwards [hbase] with n hn
  rw [weightedAverage_const_mul]
  have hm := mul_nonneg hc.le hn
  rw [mul_add, mul_div_cancel₀ ε hc.ne'] at hm
  exact hm

/-- Positive rescaling preserves pseudorandom nonpositivity. -/
lemma PseudorandomBelow.const_mul_pos
    {truth : ℕ → ℝ} {f : DeferralFunction} {P : History}
    (h : PseudorandomBelow truth f P) {c : ℝ} (hc : 0 < c) :
    PseudorandomBelow (fun n => c * truth n) f P := by
  intro W hWgen hWdiv hpatient ε hε
  have hbase := h W hWgen hWdiv hpatient (ε / c) (div_pos hε hc)
  filter_upwards [hbase] with n hn
  rw [weightedAverage_const_mul]
  have hm := mul_le_mul_of_nonneg_left hn hc.le
  rw [mul_add, mul_zero, mul_div_cancel₀ ε hc.ne'] at hm
  exact hm

/-- Cancel a positive fixed scale from asymptotic nonnegativity. -/
lemma asympGE_zero_of_const_mul_pos
    {x : ℕ → ℝ} {c : ℝ} (hc : 0 < c)
    (h : (fun n => c * x n) ≳ₙ (fun _ => 0)) :
    x ≳ₙ (fun _ => 0) := by
  intro ε hε
  have hs := h (c * ε) (mul_pos hc hε)
  filter_upwards [hs] with n hn
  have hm : 0 ≤ c * (x n + ε) := by
    simpa only [mul_add, zero_add] using hn
  exact (mul_nonneg_iff_of_pos_left hc).mp hm

/-- Cancel a positive fixed scale from asymptotic nonpositivity. -/
lemma asympLE_zero_of_const_mul_pos
    {x : ℕ → ℝ} {c : ℝ} (hc : 0 < c)
    (h : (fun n => c * x n) ≲ₙ (fun _ => 0)) :
    x ≲ₙ (fun _ => 0) := by
  intro ε hε
  have hs := h (c * ε) (mul_pos hc hε)
  filter_upwards [hs] with n hn
  have hm : c * x n ≤ c * ε := by
    simpa only [zero_add] using hn
  simpa only [zero_add] using (mul_le_mul_iff_of_pos_left hc).mp hm

/-- Cancel a positive fixed scale from asymptotic equality to zero. -/
lemma asympEq_zero_of_const_mul_pos
    {x : ℕ → ℝ} {c : ℝ} (hc : 0 < c)
    (h : (fun n => c * x n) ≈ₙ (fun _ => 0)) :
    x ≈ₙ (fun _ => 0) := by
  rw [asympEq_iff_asympLE_asympGE] at h ⊢
  exact ⟨asympLE_zero_of_const_mul_pos hc h.1,
    asympGE_zero_of_const_mul_pos hc h.2⟩

/-- Paper pseudorandomness at a fixed (possibly irrational) frequency `p`: every legal,
divergent, `f`-patient market-generated weighting sees weighted truth frequency `p`.
Keeping `p : ℝ` is essential for `thm:benford`; rationality is introduced only locally
by the squeeze proof. -/
def PseudorandomFrequency (truth : ℕ → ℝ) (p : ℝ)
    (f : DeferralFunction) (P : History) : Prop :=
  ∀ (W : ℕ → EF), PGenerableWeighting W → DivergentWeighting W P →
    DeferralPatient f W P →
      weightedAverage (fun i ↦ (W i).denote P) truth ≈ₙ (fun _ ↦ p)

/-- Paper `def:seqprand`, with the sign oriented to match its advertised conclusion:
the determined centered value is `ThmInd(φₙ) - pₙ`. -/
def VariedPseudorandomAbove (truth : ℕ → ℝ) (p : ℕ → ℚ)
    (f : DeferralFunction) (P : History) : Prop :=
  PseudorandomAbove (fun n ↦ truth n - (p n : ℝ)) f P

def VariedPseudorandomBelow (truth : ℕ → ℝ) (p : ℕ → ℚ)
    (f : DeferralFunction) (P : History) : Prop :=
  PseudorandomBelow (fun n ↦ truth n - (p n : ℝ)) f P

def VariedPseudorandom (truth : ℕ → ℝ) (p : ℕ → ℚ)
    (f : DeferralFunction) (P : History) : Prop :=
  Pseudorandom (fun n ↦ truth n - (p n : ℝ)) f P

lemma PseudorandomFrequency.variedAbove_of_lt
    {truth : ℕ → ℝ} {p : ℝ} {f : DeferralFunction} {P : History}
    (h : PseudorandomFrequency truth p f P) (q : ℚ) (hq : (q : ℝ) < p) :
    VariedPseudorandomAbove truth (fun _ ↦ q) f P := by
  intro W hWgen hWdiv hpatient
  have hfreq := h W hWgen hWdiv hpatient
  intro ε hε
  filter_upwards [hfreq.asympGE ε hε, hWdiv.eventually_prefixSum_pos] with n hn hden
  rw [weightedAverage_sub _ _ _ (ne_of_gt hden),
    weightedAverage_const _ _ (ne_of_gt hden)]
  linarith

lemma PseudorandomFrequency.variedBelow_of_lt
    {truth : ℕ → ℝ} {p : ℝ} {f : DeferralFunction} {P : History}
    (h : PseudorandomFrequency truth p f P) (q : ℚ) (hq : p < (q : ℝ)) :
    VariedPseudorandomBelow truth (fun _ ↦ q) f P := by
  intro W hWgen hWdiv hpatient
  have hfreq := h W hWgen hWdiv hpatient
  intro ε hε
  filter_upwards [hfreq.asympLE ε hε, hWdiv.eventually_prefixSum_pos] with n hn hden
  rw [weightedAverage_sub _ _ _ (ne_of_gt hden),
    weightedAverage_const _ _ (ne_of_gt hden)]
  linarith

lemma PseudorandomBelow.neg {truth : ℕ → ℝ} {f : DeferralFunction}
    {P : History} (h : PseudorandomBelow truth f P) :
    PseudorandomAbove (fun n ↦ -truth n) f P := by
  intro W hWgen hWdiv hpatient
  have hbelow := h W hWgen hWdiv hpatient
  intro ε hε
  filter_upwards [hbelow ε hε, hWdiv.eventually_prefixSum_pos] with n hn hden
  rw [weightedAverage_neg _ _ (ne_of_gt hden)]
  linarith

/-! ## Fractional-wealth feedback kernel -/

/-- The wealth after the first `k` sparse feedback bets.  Bet `i` risks the fraction
`δ * w i` of current wealth and realizes normalized price return `r i`.  This is the
mathematical recurrence in Appendix `app:wubaff`, written as its finite product so the
multiplicative accounting is explicit. -/
noncomputable def feedbackWealth (δ : ℝ) (w r : ℕ → ℝ) (k : ℕ) : ℝ :=
  ∏ i ∈ Finset.range k, (1 + δ * w i * r i)

/-- Elementary logarithmic estimate used by the Kelly argument.  The slightly coarser
factor `2` (instead of the paper's informal factor `1`) follows directly from
`1 - x⁻¹ ≤ log x` and is sufficient for the same convergence contradiction. -/
lemma sub_two_mul_sq_le_log_one_add {x : ℝ}
    (hlo : -(1 / 2 : ℝ) ≤ x) (_hhi : x ≤ 1 / 2) :
    x - 2 * x ^ 2 ≤ Real.log (1 + x) := by
  have hpos : 0 < 1 + x := by linarith
  have hlog := Real.one_sub_inv_le_log_of_pos hpos
  have hden : 0 < 1 + x := hpos
  have hpoly : x - 2 * x ^ 2 ≤ 1 - (1 + x)⁻¹ := by
    rw [inv_eq_one_div]
    have heq : 1 - 1 / (1 + x) = x / (1 + x) := by
      field_simp [ne_of_gt hden]
      ring
    rw [heq]
    apply (le_div_iff₀ hden).2
    nlinarith [sq_nonneg x, mul_nonneg (sq_nonneg x) (by linarith : 0 ≤ 1 + 2 * x)]
  exact hpoly.trans hlog

lemma feedbackBet_mem_Icc {δ w r : ℝ}
    (hδ0 : 0 ≤ δ) (hδ : δ ≤ 1 / 2)
    (hw : w ∈ Set.Icc (0 : ℝ) 1) (hr : r ∈ Set.Icc (-1 : ℝ) 1) :
    δ * w * r ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) := by
  have hδw0 : 0 ≤ δ * w := mul_nonneg hδ0 hw.1
  have hδw : δ * w ≤ 1 / 2 := by
    calc
      δ * w ≤ (1 / 2 : ℝ) * 1 := mul_le_mul hδ hw.2 hw.1 (by norm_num)
      _ = 1 / 2 := mul_one _
  constructor
  · nlinarith [mul_le_mul_of_nonneg_left hr.1 hδw0]
  · nlinarith [mul_le_mul_of_nonneg_left hr.2 hδw0]

lemma feedbackWealth_pos {δ : ℝ} {w r : ℕ → ℝ}
    (hδ0 : 0 ≤ δ) (hδ : δ ≤ 1 / 2)
    (hw : ∀ i, w i ∈ Set.Icc (0 : ℝ) 1)
    (hr : ∀ i, r i ∈ Set.Icc (-1 : ℝ) 1) (k : ℕ) :
    0 < feedbackWealth δ w r k := by
  apply Finset.prod_pos
  intro i hi
  have hbet := feedbackBet_mem_Icc hδ0 hδ (hw i) (hr i)
  linarith [hbet.1]

/-- Exact product recurrence for feedback wealth. -/
lemma feedbackWealth_succ (δ : ℝ) (w r : ℕ → ℝ) (k : ℕ) :
    feedbackWealth δ w r (k + 1) =
      feedbackWealth δ w r k * (1 + δ * w k * r k) := by
  simp [feedbackWealth, Finset.prod_range_succ]

/-- The paper's load-bearing Kelly lower bound.  Bounded weights and normalized returns
ensure every factor stays positive, while log wealth dominates weighted cumulative return
minus a quadratic risk charge. -/
lemma feedbackWealth_log_lower {δ : ℝ} {w r : ℕ → ℝ}
    (hδ0 : 0 ≤ δ) (hδ : δ ≤ 1 / 2)
    (hw : ∀ i, w i ∈ Set.Icc (0 : ℝ) 1)
    (hr : ∀ i, r i ∈ Set.Icc (-1 : ℝ) 1) (k : ℕ) :
    δ * (∑ i ∈ Finset.range k, w i * r i) -
        2 * δ ^ 2 * (∑ i ∈ Finset.range k, w i) ≤
      Real.log (feedbackWealth δ w r k) := by
  have hfactor : ∀ i ∈ Finset.range k, 1 + δ * w i * r i ≠ 0 := by
    intro i hi
    exact ne_of_gt (by
      have hbet := feedbackBet_mem_Icc hδ0 hδ (hw i) (hr i)
      linarith [hbet.1])
  rw [feedbackWealth, Real.log_prod hfactor]
  have hpoint : ∀ i ∈ Finset.range k,
      δ * (w i * r i) - 2 * δ ^ 2 * w i ≤
        Real.log (1 + δ * w i * r i) := by
    intro i hi
    have hbet := feedbackBet_mem_Icc hδ0 hδ (hw i) (hr i)
    have hlog := sub_two_mul_sq_le_log_one_add hbet.1 hbet.2
    have hw0 := (hw i).1
    have hw1 := (hw i).2
    have hrlo := (hr i).1
    have hrhi := (hr i).2
    have hrSq : (r i) ^ 2 ≤ 1 := by nlinarith [sq_nonneg (r i)]
    have hwSq : (w i) ^ 2 ≤ w i := by nlinarith [sq_nonneg (w i)]
    have hsquare : (δ * w i * r i) ^ 2 ≤ δ ^ 2 * w i := by
      calc
        (δ * w i * r i) ^ 2 = δ ^ 2 * (w i) ^ 2 * (r i) ^ 2 := by ring
        _ ≤ δ ^ 2 * (w i) ^ 2 * 1 :=
          mul_le_mul_of_nonneg_left hrSq
            (mul_nonneg (sq_nonneg δ) (sq_nonneg (w i)))
        _ ≤ δ ^ 2 * w i := by
          simpa using mul_le_mul_of_nonneg_left hwSq (sq_nonneg δ)
    calc
      δ * (w i * r i) - 2 * δ ^ 2 * w i
          ≤ δ * w i * r i - 2 * (δ * w i * r i) ^ 2 := by
            nlinarith
      _ ≤ Real.log (1 + δ * w i * r i) := hlog
  have hsum := Finset.sum_le_sum hpoint
  calc
    δ * (∑ i ∈ Finset.range k, w i * r i) -
          2 * δ ^ 2 * (∑ i ∈ Finset.range k, w i) =
        ∑ i ∈ Finset.range k,
          (δ * (w i * r i) - 2 * δ ^ 2 * w i) := by
            rw [Finset.mul_sum, Finset.mul_sum, Finset.sum_sub_distrib]
    _ ≤ ∑ i ∈ Finset.range k, Real.log (1 + δ * w i * r i) := hsum

/-- A recurrent positive weighted return margin makes the Kelly wealth genuinely
unbounded.  This is the non-vacuous upside half of the `wubaff` economic argument; the
later market theorem must still realize these returns with an efficiently computable
round-trip trader and prove its world-uniform downside bound. -/
lemma feedbackWealth_not_bddAbove_of_frequently_positive_return
    {δ γ : ℝ} {w r : ℕ → ℝ}
    (hδ0 : 0 < δ) (hδ : δ ≤ 1 / 2) (hgap : 2 * δ < γ)
    (hw : ∀ i, w i ∈ Set.Icc (0 : ℝ) 1)
    (hr : ∀ i, r i ∈ Set.Icc (-1 : ℝ) 1)
    (hmass : Tendsto (fun k ↦ ∑ i ∈ Finset.range k, w i) atTop atTop)
    (hfreq : ∃ᶠ k in atTop,
      γ * (∑ i ∈ Finset.range k, w i) ≤
        ∑ i ∈ Finset.range k, w i * r i) :
    ¬ BddAbove (Set.range (feedbackWealth δ w r)) := by
  rw [not_bddAbove_iff]
  intro B
  have hc : 0 < δ * (γ - 2 * δ) := mul_pos hδ0 (sub_pos.mpr hgap)
  have hlarge : ∀ᶠ k in atTop,
      (B + 1) / (δ * (γ - 2 * δ)) <
        ∑ i ∈ Finset.range k, w i :=
    hmass.eventually (eventually_gt_atTop _)
  obtain ⟨k, hkret, hkmass⟩ := (hfreq.and_eventually hlarge).exists
  have hlog := feedbackWealth_log_lower hδ0.le hδ hw hr k
  have hlower : δ * (γ - 2 * δ) *
      (∑ i ∈ Finset.range k, w i) ≤
        Real.log (feedbackWealth δ w r k) := by
    calc
      δ * (γ - 2 * δ) * (∑ i ∈ Finset.range k, w i) =
          δ * (γ * (∑ i ∈ Finset.range k, w i)) -
            2 * δ ^ 2 * (∑ i ∈ Finset.range k, w i) := by ring
      _ ≤ δ * (∑ i ∈ Finset.range k, w i * r i) -
            2 * δ ^ 2 * (∑ i ∈ Finset.range k, w i) := by
              gcongr
      _ ≤ Real.log (feedbackWealth δ w r k) := hlog
  have hBmass : B + 1 < δ * (γ - 2 * δ) *
      (∑ i ∈ Finset.range k, w i) :=
    by simpa [mul_comm] using (div_lt_iff₀ hc).mp hkmass
  have hwealthPos := feedbackWealth_pos hδ0.le hδ hw hr k
  have hlogLe := Real.log_le_sub_one_of_pos hwealthPos
  refine ⟨feedbackWealth δ w r k, ⟨k, rfl⟩, ?_⟩
  linarith

/-! ### Expressible Kelly coefficients -/

namespace ROIBudget

/-- A finite feature product, used to represent multiplicative Kelly wealth without an
opaque recursive certificate. -/
def prodFeatures : List EF → EF :=
  List.foldr EF.mul (EF.const 1)

lemma serialize_prodFeatures (es : List EF) :
    (prodFeatures es).serialize = es.flatMap EF.serialize ++
      (EF.const 1).serialize ++ List.replicate es.length 3 := by
  induction es with
  | nil => simp [prodFeatures, EF.serialize]
  | cons e es ih =>
      change e.serialize ++ (prodFeatures es).serialize ++ [3] = _
      rw [ih]
      simp only [List.flatMap_cons, List.length_cons]
      rw [List.replicate_succ']
      simp only [List.append_assoc]

lemma prodFeatures_denote (es : List EF) (V : History) :
    (prodFeatures es).denote V = (es.map (fun e ↦ e.denote V)).prod := by
  induction es with
  | nil => simp [prodFeatures]
  | cons e es ih =>
      change e.denote V * (prodFeatures es).denote V = _
      simp [ih]

lemma prodFeatures_denoteWith (es : List EF) (ρ : List ℝ) (V : History) :
    (prodFeatures es).denoteWith ρ V =
      (es.map (fun e ↦ e.denoteWith ρ V)).prod := by
  induction es with
  | nil => simp [prodFeatures]
  | cons e es ih =>
      change e.denoteWith ρ V * (prodFeatures es).denoteWith ρ V = _
      simp [ih]

lemma prodFeatures_rank_le (es : List EF) (n : ℕ)
    (h : ∀ e ∈ es, e.rank ≤ n) : (prodFeatures es).rank ≤ n := by
  induction es with
  | nil => change 0 ≤ n; omega
  | cons e es ih =>
      change Nat.max e.rank (prodFeatures es).rank ≤ n
      exact Nat.max_le.mpr ⟨h e (by simp), ih (fun x hx ↦ h x (by simp [hx]))⟩

end ROIBudget

namespace AffineCombination

/-- Price return of component `A_{f k}` between its supported prediction day `f k` and
the next feedback day `f(k+1)`, represented as one closed market feature. -/
def feedbackReturnFeature (As : ℕ → AffineCombination)
    (f : DeferralFunction) (k : ℕ) : EF :=
  EF.add ((As (f k)).priceFeature (f (k + 1)))
    (EF.mul (EF.const (-1)) ((As (f k)).priceFeature (f k)))

@[simp] theorem feedbackReturnFeature_denote
    (As : ℕ → AffineCombination) (f : DeferralFunction)
    (P : History) (k : ℕ) :
    (feedbackReturnFeature As f k).denote P =
      (As (f k)).price P (f (k + 1)) - (As (f k)).price P (f k) := by
  simp [feedbackReturnFeature, priceFeature_denote]
  ring

/-- One multiplicative Kelly factor `1 + δ·w_{f k}·return_k`. -/
def feedbackFactorFeature (As : ℕ → AffineCombination) (W : ℕ → EF)
    (f : DeferralFunction) (δ : ℚ) (k : ℕ) : EF :=
  EF.add (EF.const 1)
    (EF.mul (EF.mul (EF.const δ) (W (f k))) (feedbackReturnFeature As f k))

/-- Wealth before supported bet `k`, as the explicit product of all earlier factors. -/
def feedbackWealthFeature (As : ℕ → AffineCombination) (W : ℕ → EF)
    (f : DeferralFunction) (δ : ℚ) (k : ℕ) : EF :=
  ROIBudget.prodFeatures
    ((List.range k).map (feedbackFactorFeature As W f δ))

/-- Shares opened at `f k`: `δ · Wealth_k · w_{f k}`. -/
def feedbackBetaFeature (As : ℕ → AffineCombination) (W : ℕ → EF)
    (f : DeferralFunction) (δ : ℚ) (k : ℕ) : EF :=
  EF.mul (EF.mul (EF.const δ) (feedbackWealthFeature As W f δ k)) (W (f k))

lemma feedbackReturnFeature_rank_le {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) {j k : ℕ} (hjk : j < k) :
    (feedbackReturnFeature As f j).rank ≤ f k := by
  have hfj : f j ≤ f k := (hstrict.monotone (Nat.le_of_lt hjk))
  have hsucc : f (j + 1) ≤ f k := hstrict.monotone (by omega)
  have hbase : j ≤ f j := (f.lt j).le
  have hcur := (As (f j)).priceFeature_rank (le_refl (f j))
    (hpoly.const_rank (f j)) (hpoly.terms_rank (f j))
  have hfuture := (As (f j)).priceFeature_rank (hstrict.monotone (Nat.le_succ j))
    (hpoly.const_rank (f j)) (hpoly.terms_rank (f j))
  simp only [feedbackReturnFeature, EF.rank]
  exact Nat.max_le.mpr ⟨hfuture.trans hsucc,
    Nat.max_le.mpr ⟨by omega, hcur.trans hfj⟩⟩

lemma feedbackFactorFeature_rank_le {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    {f : DeferralFunction} (hstrict : StrictlyIncreasingDeferral f)
    (δ : ℚ) {j k : ℕ} (hjk : j < k) :
    (feedbackFactorFeature As W f δ j).rank ≤ f k := by
  have hWrank : (W (f j)).rank ≤ f k :=
    (hW.rank_le (f j)).trans (hstrict.monotone (Nat.le_of_lt hjk))
  simp only [feedbackFactorFeature, EF.rank]
  exact Nat.max_le.mpr ⟨by omega,
    Nat.max_le.mpr ⟨Nat.max_le.mpr ⟨by omega, hWrank⟩,
      feedbackReturnFeature_rank_le hpoly hstrict hjk⟩⟩

lemma feedbackWealthFeature_rank_le {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    {f : DeferralFunction} (hstrict : StrictlyIncreasingDeferral f)
    (δ : ℚ) (k : ℕ) :
    (feedbackWealthFeature As W f δ k).rank ≤ f k := by
  apply ROIBudget.prodFeatures_rank_le
  intro e he
  simp only [List.mem_map, List.mem_range] at he
  obtain ⟨j, hj, rfl⟩ := he
  exact feedbackFactorFeature_rank_le hpoly hW hstrict δ hj

lemma feedbackBetaFeature_rank_le {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    {f : DeferralFunction} (hstrict : StrictlyIncreasingDeferral f)
    (δ : ℚ) (k : ℕ) :
    (feedbackBetaFeature As W f δ k).rank ≤ f k := by
  simp only [feedbackBetaFeature, EF.rank]
  exact Nat.max_le.mpr ⟨Nat.max_le.mpr ⟨by omega,
    feedbackWealthFeature_rank_le hpoly hW hstrict δ k⟩, hW.rank_le (f k)⟩

lemma feedbackReturnFeature_closed {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) (f : DeferralFunction) (k : ℕ)
    (ρ : List ℝ) (P : History) :
    (feedbackReturnFeature As f k).denoteWith ρ P =
      (feedbackReturnFeature As f k).denote P := by
  simp only [feedbackReturnFeature, EF.denoteWith, EF.denote_add, EF.denote_mul,
    Pi.add_apply, Pi.mul_apply, EF.denote_const]
  rw [hpoly.priceFeature_closed (f k) (f (k + 1)) ρ P,
    hpoly.priceFeature_closed (f k) (f k) ρ P]

lemma feedbackFactorFeature_closed {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    (f : DeferralFunction) (δ : ℚ) (k : ℕ) (ρ : List ℝ) (P : History) :
    (feedbackFactorFeature As W f δ k).denoteWith ρ P =
      (feedbackFactorFeature As W f δ k).denote P := by
  simp only [feedbackFactorFeature, EF.denoteWith, EF.denote_add, EF.denote_mul,
    Pi.add_apply, Pi.mul_apply, EF.denote_const]
  rw [hW.closed (f k) ρ P, feedbackReturnFeature_closed hpoly f k ρ P]

lemma feedbackWealthFeature_closed {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    (f : DeferralFunction) (δ : ℚ) (k : ℕ) (ρ : List ℝ) (P : History) :
    (feedbackWealthFeature As W f δ k).denoteWith ρ P =
      (feedbackWealthFeature As W f δ k).denote P := by
  rw [feedbackWealthFeature, ROIBudget.prodFeatures_denoteWith,
    ROIBudget.prodFeatures_denote]
  congr 1
  apply List.map_congr_left
  intro e he
  simp only [List.mem_map, List.mem_range] at he
  obtain ⟨j, hj, rfl⟩ := he
  exact feedbackFactorFeature_closed hpoly hW f δ j ρ P

lemma feedbackBetaFeature_closed {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    (f : DeferralFunction) (δ : ℚ) (k : ℕ) (ρ : List ℝ) (P : History) :
    (feedbackBetaFeature As W f δ k).denoteWith ρ P =
      (feedbackBetaFeature As W f δ k).denote P := by
  simp only [feedbackBetaFeature, EF.denoteWith, EF.denote_mul,
    Pi.mul_apply, EF.denote_const]
  rw [feedbackWealthFeature_closed hpoly hW f δ k ρ P, hW.closed (f k) ρ P]

@[simp] theorem feedbackFactorFeature_denote
    (As : ℕ → AffineCombination) (W : ℕ → EF) (f : DeferralFunction)
    (δ : ℚ) (P : History) (k : ℕ) :
    (feedbackFactorFeature As W f δ k).denote P =
      1 + (δ : ℝ) * (W (f k)).denote P *
        ((As (f k)).price P (f (k + 1)) - (As (f k)).price P (f k)) := by
  simp [feedbackFactorFeature, feedbackReturnFeature_denote]

lemma feedbackWealthFeature_denote
    (As : ℕ → AffineCombination) (W : ℕ → EF) (f : DeferralFunction)
    (δ : ℚ) (P : History) (k : ℕ) :
    (feedbackWealthFeature As W f δ k).denote P =
      feedbackWealth (δ : ℝ) (fun j ↦ (W (f j)).denote P)
        (fun j ↦ (As (f j)).price P (f (j + 1)) -
          (As (f j)).price P (f j)) k := by
  induction k with
  | zero => simp [feedbackWealthFeature, feedbackWealth, ROIBudget.prodFeatures_denote]
  | succ k ih =>
      rw [feedbackWealthFeature, ROIBudget.prodFeatures_denote, List.range_succ,
        List.map_append, List.map_append, List.prod_append]
      simp only [List.map_singleton, List.prod_singleton]
      rw [← ROIBudget.prodFeatures_denote]
      change (feedbackWealthFeature As W f δ k).denote P *
          (feedbackFactorFeature As W f δ k).denote P = _
      rw [ih, feedbackFactorFeature_denote, feedbackWealth_succ]

lemma feedbackBetaFeature_denote
    (As : ℕ → AffineCombination) (W : ℕ → EF) (f : DeferralFunction)
    (δ : ℚ) (P : History) (k : ℕ) :
    (feedbackBetaFeature As W f δ k).denote P =
      (δ : ℝ) *
        feedbackWealth (δ : ℝ) (fun j ↦ (W (f j)).denote P)
          (fun j ↦ (As (f j)).price P (f (j + 1)) -
            (As (f j)).price P (f j)) k *
        (W (f k)).denote P := by
  simp [feedbackBetaFeature, feedbackWealthFeature_denote]

/-! ### The concrete sparse round-trip trader -/

/-- The affine position opened at feedback index `k`.  Its coefficient is exactly the
Kelly share count `δ · Wealth_k · w_{f k}` constructed above. -/
def feedbackPosition (As : ℕ → AffineCombination) (W : ℕ → EF)
    (f : DeferralFunction) (δ : ℚ) (k : ℕ) : AffineCombination :=
  (As (f k)).scale (feedbackBetaFeature As W f δ k)

lemma feedbackPosition_terms_rank_le {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    {f : DeferralFunction} (hstrict : StrictlyIncreasingDeferral f)
    (δ : ℚ) (k : ℕ) :
    ∀ p ∈ (feedbackPosition As W f δ k).terms, p.1.rank ≤ f k :=
  scale_terms_rank_le _ _
    (feedbackBetaFeature_rank_le hpoly hW hstrict δ k)
    (hpoly.terms_rank (f k))

/-- Component `k` opens its Kelly-scaled affine position at `f k` and closes it at the
next feedback day `f(k+1)`. -/
def feedbackRoundTrip {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ) (k : ℕ) : Trader :=
  (feedbackPosition As W f δ k).roundTrip (f k) (f (k + 1))
    (hstrict (Nat.lt_succ_self k))
    (feedbackPosition_terms_rank_le hpoly hW hstrict δ k)

/-- Once component `k` has closed, its world-independent profit is exactly the increment
of the explicit feedback wealth recurrence. -/
lemma feedbackRoundTrip_netWorth_close {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    {f : DeferralFunction} (hstrict : StrictlyIncreasingDeferral f)
    (δ : ℚ) (P : History) (v : PCWorld) (k n : ℕ) (hn : f (k + 1) ≤ n) :
    (feedbackRoundTrip hpoly hW hstrict δ k).netWorth P v n =
      feedbackWealth (δ : ℝ) (fun j ↦ (W (f j)).denote P)
          (fun j ↦ (As (f j)).price P (f (j + 1)) -
            (As (f j)).price P (f j)) (k + 1) -
        feedbackWealth (δ : ℝ) (fun j ↦ (W (f j)).denote P)
          (fun j ↦ (As (f j)).price P (f (j + 1)) -
            (As (f j)).price P (f j)) k := by
  rw [feedbackRoundTrip, roundTrip_netWorth _ P v (f k) (f (k + 1)) n
    (hstrict (Nat.lt_succ_self k))
    (feedbackPosition_terms_rank_le hpoly hW hstrict δ k) hn]
  simp only [feedbackPosition, scale_price, feedbackBetaFeature_denote]
  rw [feedbackWealth_succ]
  ring

lemma feedbackRoundTrip_netWorth_before_open {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    {f : DeferralFunction} (hstrict : StrictlyIncreasingDeferral f)
    (δ : ℚ) (P : History) (v : PCWorld) (k n : ℕ) (hn : n < f k) :
    (feedbackRoundTrip hpoly hW hstrict δ k).netWorth P v n = 0 := by
  rw [Trader.netWorth]
  apply Finset.sum_eq_zero
  intro i hi
  rw [feedbackRoundTrip]
  apply roundTrip_value_other
  · simp only [Finset.mem_range] at hi
    omega
  · have hnext : f k < f (k + 1) := hstrict (by omega)
    simp only [Finset.mem_range] at hi
    omega

lemma feedbackRoundTrip_netWorth_open {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    {f : DeferralFunction} (hstrict : StrictlyIncreasingDeferral f)
    (δ : ℚ) (P : History) (v : PCWorld) (k : ℕ) :
    (feedbackRoundTrip hpoly hW hstrict δ k).netWorth P v (f k) =
      (feedbackBetaFeature As W f δ k).denote P *
        ((As (f k)).value P v.payout - (As (f k)).price P (f k)) := by
  rw [Trader.netWorth, Finset.sum_eq_single (f k)]
  · rw [feedbackRoundTrip, roundTrip_value_open]
    simp only [feedbackPosition, scale_value, scale_price]
    ring
  · intro i hi hne
    rw [feedbackRoundTrip]
    apply roundTrip_value_other
    · exact hne
    · have hnext : f k < f (k + 1) := hstrict (by omega)
      simp only [Finset.mem_range] at hi
      omega
  · intro hnot
    simp at hnot

lemma feedbackRoundTrip_netWorth_during_open {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    {f : DeferralFunction} (hstrict : StrictlyIncreasingDeferral f)
    (δ : ℚ) (P : History) (v : PCWorld) (k n : ℕ)
    (hopen : f k ≤ n) (hclose : n < f (k + 1)) :
    (feedbackRoundTrip hpoly hW hstrict δ k).netWorth P v n =
      (feedbackBetaFeature As W f δ k).denote P *
        ((As (f k)).value P v.payout - (As (f k)).price P (f k)) := by
  rw [Trader.netWorth, Finset.sum_eq_single (f k)]
  · rw [feedbackRoundTrip, roundTrip_value_open]
    simp only [feedbackPosition, scale_value, scale_price]
    ring
  · intro i hi hne
    rw [feedbackRoundTrip]
    apply roundTrip_value_other
    · exact hne
    · simp only [Finset.mem_range] at hi
      omega
  · intro hnot
    simp at hnot
    omega

/-- All components strictly before feedback index `k` have closed by day `f k`, and
their realized profits telescope to `Wealth_k - 1`. -/
lemma feedbackRoundTrip_closed_sum {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    {f : DeferralFunction} (hstrict : StrictlyIncreasingDeferral f)
    (δ : ℚ) (P : History) (v : PCWorld) (k n : ℕ) (hn : f k ≤ n) :
    (∑ j ∈ Finset.range k,
        (feedbackRoundTrip hpoly hW hstrict δ j).netWorth P v n) =
      feedbackWealth (δ : ℝ) (fun j ↦ (W (f j)).denote P)
          (fun j ↦ (As (f j)).price P (f (j + 1)) -
            (As (f j)).price P (f j)) k - 1 := by
  calc
    (∑ j ∈ Finset.range k,
        (feedbackRoundTrip hpoly hW hstrict δ j).netWorth P v n) =
      ∑ j ∈ Finset.range k,
        (feedbackWealth (δ : ℝ) (fun i ↦ (W (f i)).denote P)
            (fun i ↦ (As (f i)).price P (f (i + 1)) -
              (As (f i)).price P (f i)) (j + 1) -
          feedbackWealth (δ : ℝ) (fun i ↦ (W (f i)).denote P)
            (fun i ↦ (As (f i)).price P (f (i + 1)) -
              (As (f i)).price P (f i)) j) := by
        apply Finset.sum_congr rfl
        intro j hj
        apply feedbackRoundTrip_netWorth_close hpoly hW hstrict δ P v
        apply (hstrict.monotone ?_).trans hn
        simp only [Finset.mem_range] at hj
        omega
    _ = feedbackWealth (δ : ℝ) (fun j ↦ (W (f j)).denote P)
          (fun j ↦ (As (f j)).price P (f (j + 1)) -
            (As (f j)).price P (f j)) k - 1 := by
        rw [Finset.sum_range_sub]
        simp [feedbackWealth]

/-- The actual feedback trader.  Its day-`n` strategy joins the first `n+1` finite
round-trip components.  Since `f k > k`, no component outside this finite prefix can open
or close by day `n`; the redundant empty components make the definition independent of a
hidden inverse for `f`. -/
def feedbackTrader {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ) : Trader where
  strat n := Strategy.join ((List.range (n + 1)).map fun k ↦
    (feedbackRoundTrip hpoly hW hstrict δ k).strat n)

/-- Proof-erased day-`n` trade list of one feedback round trip.  This is deliberately the
literal syntax of `feedbackRoundTrip`, not a value-equivalent normal form: the closing
branch retains `AffineCombination.neg`'s actual nested coefficient multiplication. -/
def feedbackRoundTripTrades (As : ℕ → AffineCombination) (W : ℕ → EF)
    (f : DeferralFunction) (δ : ℚ) (k n : ℕ) : List (EF × Sentence) :=
  if n = f k then (feedbackPosition As W f δ k).terms
  else if n = f (k + 1) then (feedbackPosition As W f δ k).neg.terms
  else []

/-- The proof-bearing round-trip trader has exactly the proof-erased trade list above. -/
lemma feedbackRoundTrip_trades
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ) (k n : ℕ) :
    ((feedbackRoundTrip hpoly hW hstrict δ k).strat n).trades =
      feedbackRoundTripTrades As W f δ k n := by
  by_cases hopen : n = f k
  · subst n
    rw [feedbackRoundTrip, roundTrip_strat_open]
    simp [feedbackRoundTripTrades]
  · by_cases hclose : n = f (k + 1)
    · subst n
      rw [feedbackRoundTrip, roundTrip_strat_close]
      simp [feedbackRoundTripTrades, ne_of_gt (hstrict (Nat.lt_succ_self k))]
    · rw [feedbackRoundTrip, roundTrip_strat_other _ _ _ _ _ _ hopen hclose]
      simp [feedbackRoundTripTrades, hopen, hclose, emptyStrategy]

/-- Complete proof-erased day-`n` syntax of the joined feedback trader. -/
def feedbackTraderTrades (As : ℕ → AffineCombination) (W : ℕ → EF)
    (f : DeferralFunction) (δ : ℚ) (n : ℕ) : List (EF × Sentence) :=
  (List.range (n + 1)).flatMap fun k ↦ feedbackRoundTripTrades As W f δ k n

/-- `feedbackTraderTrades` is literal list equality with the existing economic trader. -/
lemma feedbackTrader_trades
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ) (n : ℕ) :
    ((feedbackTrader hpoly hW hstrict δ).strat n).trades =
      feedbackTraderTrades As W f δ n := by
  simp only [feedbackTrader, Strategy.join, List.flatMap_map, feedbackTraderTrades]
  apply List.flatMap_congr
  intro k hk
  exact feedbackRoundTrip_trades hpoly hW hstrict δ k n

/-- Structured token-emission boundary for the concrete feedback trader.  It exposes
the exact trade count, each coefficient feature, and each sentence code; `trades_eq`
requires these fields to reconstruct the trader's real day strategy.  It contains no
prices, worlds, wealth bounds, bias premise, exploitation claim, or logical-induction
conclusion.  Constructing it uniformly from a deferral program is the ledgered
`M7-FEEDBACK-EMIT` bounded-dovetail obligation.
Paper node: `thm:wubaff` (App. `wubaff`), reused by `thm:wubexp`. -/
structure FeedbackTraderEmission
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ) where
  tradeCount : ℕ → ℕ
  coefficient : ℕ → EF
  sentence : ℕ → Sentence
  tradeCount_poly : ∃ c, PolyFueled c tradeCount
  coefficient_poly : PolySegStream (fun z ↦ (coefficient z).serialize)
  sentence_poly : ∃ c, PolyFueled c (fun z ↦ Encodable.encode (sentence z))
  trades_eq : ∀ n,
    ((feedbackTrader hpoly hW hstrict δ).strat n).trades =
      (List.range (tradeCount n)).map (fun j ↦
        (coefficient (Nat.pair n j), sentence (Nat.pair n j)))

/-- Uniform emission boundary for every sufficiently small rational Kelly fraction.
The feedback proof selects the fraction only after receiving an analytic error tolerance,
so a single preselected trader is not enough for the paper's quantified convergence
claim.  Each member is still the exact, conclusion-free `FeedbackTraderEmission` above.
Paper node: `thm:wubaff` (App. `wubaff`). -/
structure FeedbackTraderEmissionFamily
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) where
  emit : ∀ δ : ℚ, 0 < (δ : ℝ) → (δ : ℝ) ≤ 1 / 2 →
    FeedbackTraderEmission hpoly hW hstrict δ

/-- The two sign orientations required for an equality conclusion.  The negative family
emits the same concrete Kelly construction applied to the explicitly negated affine
sequence; no bias or convergence claim is stored in this boundary.
Paper node: `thm:wubaff` (App. `wubaff`). -/
structure FeedbackTraderEmissionSigns
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) where
  positive : FeedbackTraderEmissionFamily hpoly hW hstrict
  negative : FeedbackTraderEmissionFamily hpoly.neg hW hstrict

/-- A structured feedback emitter yields a real token-indexed efficient-computability
certificate for the actual joined trader. -/
lemma feedbackTrader_ecTok
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    (emit : FeedbackTraderEmission hpoly hW hstrict δ) :
    EfficientlyComputableTok (feedbackTrader hpoly hW hstrict δ) := by
  obtain ⟨ccount, hcount⟩ := emit.tradeCount_poly
  obtain ⟨csentence, hsentence⟩ := emit.sentence_poly
  have htag : PolySegStream (fun _ ↦ [6]) :=
    PolySegStream.ofTokenStream (PolyTokenStream.const 6)
  have hsentenceSeg : PolySegStream (fun z ↦
      [Encodable.encode (emit.sentence z)]) :=
    PolySegStream.ofTokenStream (PolyTokenStream.polyTok hsentence)
  have hone : PolySegStream (fun z ↦
      serializeTrades [(emit.coefficient z, emit.sentence z)]) := by
    refine PolySegStream.of_eq ((emit.coefficient_poly.append htag).append hsentenceSeg) ?_
    intro z
    simp [serializeTrades, List.append_assoc]
  refine ecTok_of_segStream _ (PolySegStream.of_eq
    (PolySegStream.concatVar hone hcount) ?_)
  intro n
  rw [emit.trades_eq, serializeTrades_map_singleton]

private lemma feedback_list_range_map_sum (g : ℕ → ℝ) : ∀ n,
    ((List.range n).map g).sum = ∑ k ∈ Finset.range n, g k
  | 0 => by simp
  | n + 1 => by
      rw [List.range_succ, List.map_append, List.sum_append,
        Finset.sum_range_succ, feedback_list_range_map_sum g n]
      simp

lemma feedbackTrader_strat_value {As : ℕ → AffineCombination}
    (hpoly : PolySequence As) {W : ℕ → EF} (hW : PGenerableWeighting W)
    {f : DeferralFunction} (hstrict : StrictlyIncreasingDeferral f)
    (δ : ℚ) (P : History) (w : Valuation) (n : ℕ) :
    ((feedbackTrader hpoly hW hstrict δ).strat n).value P w =
      ∑ k ∈ Finset.range (n + 1),
        ((feedbackRoundTrip hpoly hW hstrict δ k).strat n).value P w := by
  rw [feedbackTrader, Strategy.join_value]
  simpa [Function.comp_def] using feedback_list_range_map_sum
    (fun k ↦ ((feedbackRoundTrip hpoly hW hstrict δ k).strat n).value P w) (n + 1)

lemma feedbackRoundTrip_value_zero_of_day_lt_index
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    (P : History) (w : Valuation) {n k : ℕ} (hnk : n < k) :
    ((feedbackRoundTrip hpoly hW hstrict δ k).strat n).value P w = 0 := by
  rw [feedbackRoundTrip]
  apply roundTrip_value_other
  · intro hn
    have hk := f.lt k
    omega
  · intro hn
    have hk := f.lt (k + 1)
    omega

lemma feedbackTrader_strat_value_full_prefix
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    (P : History) (w : Valuation) {n N : ℕ} (hnN : n ≤ N) :
    ((feedbackTrader hpoly hW hstrict δ).strat n).value P w =
      ∑ k ∈ Finset.range (N + 1),
        ((feedbackRoundTrip hpoly hW hstrict δ k).strat n).value P w := by
  rw [feedbackTrader_strat_value]
  apply Finset.sum_subset (Finset.range_mono (by omega))
  intro k hkN hkn
  simp only [Finset.mem_range] at hkN hkn
  exact feedbackRoundTrip_value_zero_of_day_lt_index hpoly hW hstrict δ P w (by omega)

/-- Finite-prefix accounting for the joined trader.  This theorem is deliberately about
the concrete `Trader.netWorth`, not an abstract wealth certificate: it reorders the
actual finite sum of emitted day strategies into the sum of component round trips. -/
lemma feedbackTrader_netWorth_eq_component_sum
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    (P : History) (v : PCWorld) (N : ℕ) :
    (feedbackTrader hpoly hW hstrict δ).netWorth P v N =
      ∑ k ∈ Finset.range (N + 1),
        (feedbackRoundTrip hpoly hW hstrict δ k).netWorth P v N := by
  rw [Trader.netWorth]
  calc
    ∑ n ∈ Finset.range (N + 1),
        ((feedbackTrader hpoly hW hstrict δ).strat n).value P v.payout =
      ∑ n ∈ Finset.range (N + 1), ∑ k ∈ Finset.range (N + 1),
        ((feedbackRoundTrip hpoly hW hstrict δ k).strat n).value P v.payout := by
          apply Finset.sum_congr rfl
          intro n hn
          exact feedbackTrader_strat_value_full_prefix hpoly hW hstrict δ P v.payout
            (by simpa using hn)
    _ = ∑ k ∈ Finset.range (N + 1), ∑ n ∈ Finset.range (N + 1),
        ((feedbackRoundTrip hpoly hW hstrict δ k).strat n).value P v.payout := by
          rw [Finset.sum_comm]
    _ = ∑ k ∈ Finset.range (N + 1),
        (feedbackRoundTrip hpoly hW hstrict δ k).netWorth P v N := by
          apply Finset.sum_congr rfl
          intro k _
          rfl

/-- Greatest feedback index whose opening day has arrived, searched only through `n`.
The search bound is complete because every deferral satisfies `k < f k`. -/
def feedbackStage (f : DeferralFunction) (n : ℕ) : ℕ :=
  Nat.findGreatest (fun k ↦ f k ≤ n) n

lemma feedbackStage_le (f : DeferralFunction) (n : ℕ) : feedbackStage f n ≤ n :=
  Nat.findGreatest_le n

lemma feedbackStage_open {f : DeferralFunction} {n : ℕ} (h0 : f 0 ≤ n) :
    f (feedbackStage f n) ≤ n := by
  exact Nat.findGreatest_spec (P := fun k ↦ f k ≤ n) (zero_le n) h0

lemma feedbackStage_before_next {f : DeferralFunction} {n : ℕ} :
    n < f (feedbackStage f n + 1) := by
  by_contra hnot
  have hpred : f (feedbackStage f n + 1) ≤ n := by omega
  have hidx : feedbackStage f n + 1 ≤ n :=
    (f.lt (feedbackStage f n + 1)).le.trans hpred
  have hg : feedbackStage f n + 1 ≤ feedbackStage f n := by
    exact Nat.le_findGreatest (P := fun k ↦ f k ≤ n) hidx hpred
  omega

lemma feedbackTrader_netWorth_before_first
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    (P : History) (v : PCWorld) {n : ℕ} (hn : n < f 0) :
    (feedbackTrader hpoly hW hstrict δ).netWorth P v n = 0 := by
  rw [feedbackTrader_netWorth_eq_component_sum]
  apply Finset.sum_eq_zero
  intro k hk
  apply feedbackRoundTrip_netWorth_before_open hpoly hW hstrict δ P v
  exact hn.trans_le (hstrict.monotone (zero_le k))

/-- Exact arbitrary-day accounting after the first opening.  The bounded search stage
identifies the sole live component without becoming part of the trader definition or its
computability certificate. -/
lemma feedbackTrader_netWorth_at_stage
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    (P : History) (v : PCWorld) {n : ℕ} (h0 : f 0 ≤ n) :
    (feedbackTrader hpoly hW hstrict δ).netWorth P v n =
      feedbackWealth (δ : ℝ) (fun j ↦ (W (f j)).denote P)
          (fun j ↦ (As (f j)).price P (f (j + 1)) -
            (As (f j)).price P (f j)) (feedbackStage f n) - 1 +
        (feedbackBetaFeature As W f δ (feedbackStage f n)).denote P *
          ((As (f (feedbackStage f n))).value P v.payout -
            (As (f (feedbackStage f n))).price P (f (feedbackStage f n))) := by
  let k := feedbackStage f n
  have hkn : k ≤ n := feedbackStage_le f n
  have hopen : f k ≤ n := feedbackStage_open h0
  have hclose : n < f (k + 1) := feedbackStage_before_next
  rw [feedbackTrader_netWorth_eq_component_sum]
  have hprefix :
      (∑ j ∈ Finset.range (k + 1),
          (feedbackRoundTrip hpoly hW hstrict δ j).netWorth P v n) =
        ∑ j ∈ Finset.range (n + 1),
          (feedbackRoundTrip hpoly hW hstrict δ j).netWorth P v n := by
    apply Finset.sum_subset (Finset.range_mono (by omega))
    intro j hj hnot
    simp only [Finset.mem_range] at hj hnot
    apply feedbackRoundTrip_netWorth_before_open hpoly hW hstrict δ P v
    exact hclose.trans_le (hstrict.monotone (by omega))
  rw [← hprefix, Finset.sum_range_succ,
    feedbackRoundTrip_closed_sum hpoly hW hstrict δ P v k n hopen,
    feedbackRoundTrip_netWorth_during_open hpoly hW hstrict δ P v k n hopen hclose]

/-- Kelly's bounded-downside invariant for the actual joined trader.  It is uniform in
the assessment world and day: normalized affine magnitude bounds the sole live position,
while positivity of the explicit multiplicative wealth makes all completed gains absorb
that risk. -/
lemma feedbackTrader_netWorth_lower
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    {P : History} (hWdiv : DivergentWeighting W P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hδ0 : 0 ≤ (δ : ℝ)) (hδ : (δ : ℝ) ≤ 1 / 2)
    (v : PCWorld) (n : ℕ) :
    -1 ≤ (feedbackTrader hpoly hW hstrict δ).netWorth P v n := by
  by_cases h0 : f 0 ≤ n
  · let k := feedbackStage f n
    let weights : ℕ → ℝ := fun j ↦ (W (f j)).denote P
    let returns : ℕ → ℝ := fun j ↦
      (As (f j)).price P (f (j + 1)) - (As (f j)).price P (f j)
    have hw : ∀ j, weights j ∈ Set.Icc (0 : ℝ) 1 := fun j ↦ hWdiv.1 (f j)
    have hr : ∀ j, returns j ∈ Set.Icc (-1 : ℝ) 1 := by
      intro j
      have ha := (As (f j)).abs_price_sub_price_le_magnitude P
        (f (j + 1)) (f j) (hP (f (j + 1))) (hP (f j))
      have hm := hmag (f j)
      rw [abs_le] at ha
      exact ⟨by dsimp [returns]; linarith, by dsimp [returns]; linarith⟩
    have hwealth : 0 < feedbackWealth (δ : ℝ) weights returns k :=
      feedbackWealth_pos hδ0 hδ hw hr k
    have hdiffAbs := (As (f k)).abs_value_sub_price_le_magnitude P v.payout (f k)
      (hpoly.terms_rank (f k))
      (fun φ ↦ by
        by_cases hφ : v.Holds φ
        · exact Or.inr (by simp [PCWorld.payout, hφ])
        · exact Or.inl (by simp [PCWorld.payout, hφ]))
      (hP (f k))
    have hdiff : -1 ≤
        (As (f k)).value P v.payout - (As (f k)).price P (f k) := by
      rw [abs_le] at hdiffAbs
      linarith [hmag (f k)]
    have hcoef0 : 0 ≤ (δ : ℝ) * feedbackWealth (δ : ℝ) weights returns k * weights k :=
      mul_nonneg (mul_nonneg hδ0 hwealth.le) (hw k).1
    have hopenLower :
        -((δ : ℝ) * feedbackWealth (δ : ℝ) weights returns k * weights k) ≤
          ((δ : ℝ) * feedbackWealth (δ : ℝ) weights returns k * weights k) *
            ((As (f k)).value P v.payout - (As (f k)).price P (f k)) := by
      nlinarith [mul_le_mul_of_nonneg_left hdiff hcoef0]
    have hδw : (δ : ℝ) * weights k ≤ 1 := by
      calc
        (δ : ℝ) * weights k ≤ (1 / 2 : ℝ) * 1 :=
          mul_le_mul hδ (hw k).2 (hw k).1 (by norm_num)
        _ ≤ 1 := by norm_num
    have hstake :
        (δ : ℝ) * feedbackWealth (δ : ℝ) weights returns k * weights k ≤
          feedbackWealth (δ : ℝ) weights returns k := by
      have hm := mul_le_mul_of_nonneg_left hδw hwealth.le
      nlinarith
    rw [feedbackTrader_netWorth_at_stage hpoly hW hstrict δ P v h0,
      feedbackBetaFeature_denote]
    change -1 ≤ feedbackWealth (δ : ℝ) weights returns k - 1 +
      ((δ : ℝ) * feedbackWealth (δ : ℝ) weights returns k * weights k) *
        ((As (f k)).value P v.payout - (As (f k)).price P (f k))
    linarith
  · have hn : n < f 0 := by omega
    rw [feedbackTrader_netWorth_before_first hpoly hW hstrict δ P v hn]
    norm_num

lemma feedbackTrader_plausible_bddBelow
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    {P : History} (hWdiv : DivergentWeighting W P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hδ0 : 0 ≤ (δ : ℝ)) (hδ : (δ : ℝ) ≤ 1 / 2)
    (DP : DeductiveProcess) :
    BddBelow ((feedbackTrader hpoly hW hstrict δ).plausibleAssessments P DP) := by
  refine ⟨-1, ?_⟩
  rintro x ⟨n, v, _hv, rfl⟩
  exact feedbackTrader_netWorth_lower hpoly hW hstrict δ hWdiv hmag hP hδ0 hδ v n

/-- Quantitative form of the live-position Kelly invariant.  At most half of positive
wealth is at risk, so even the worst normalized world value leaves at least half of that
wealth. -/
lemma half_wealth_sub_one_le_with_live_position
    {δ wealth w d : ℝ} (hδ0 : 0 ≤ δ) (hδ : δ ≤ 1 / 2)
    (hwealth : 0 ≤ wealth) (hw : w ∈ Set.Icc (0 : ℝ) 1) (hd : -1 ≤ d) :
    wealth / 2 - 1 ≤ wealth - 1 + δ * wealth * w * d := by
  have hcoef0 : 0 ≤ δ * wealth * w :=
    mul_nonneg (mul_nonneg hδ0 hwealth) hw.1
  have hlive : -(δ * wealth * w) ≤ δ * wealth * w * d := by
    nlinarith [mul_le_mul_of_nonneg_left hd hcoef0]
  have hδw : δ * w ≤ 1 / 2 := by
    calc
      δ * w ≤ (1 / 2 : ℝ) * 1 := mul_le_mul hδ hw.2 hw.1 (by norm_num)
      _ = 1 / 2 := by norm_num
  have hstake : δ * wealth * w ≤ wealth / 2 := by
    have hm := mul_le_mul_of_nonneg_left hδw hwealth
    nlinarith
  linarith

/-- Exact accounting on a feedback day: all earlier components telescope to
`Wealth_k - 1`, component `k` is the sole live position, and every later component is
still unopened. -/
lemma feedbackTrader_netWorth_at_feedback
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    (P : History) (v : PCWorld) (k : ℕ) :
    (feedbackTrader hpoly hW hstrict δ).netWorth P v (f k) =
      feedbackWealth (δ : ℝ) (fun j ↦ (W (f j)).denote P)
          (fun j ↦ (As (f j)).price P (f (j + 1)) -
            (As (f j)).price P (f j)) k - 1 +
        (feedbackBetaFeature As W f δ k).denote P *
          ((As (f k)).value P v.payout - (As (f k)).price P (f k)) := by
  rw [feedbackTrader_netWorth_eq_component_sum]
  have hprefix :
      (∑ j ∈ Finset.range (k + 1),
          (feedbackRoundTrip hpoly hW hstrict δ j).netWorth P v (f k)) =
        ∑ j ∈ Finset.range (f k + 1),
          (feedbackRoundTrip hpoly hW hstrict δ j).netWorth P v (f k) := by
    apply Finset.sum_subset (Finset.range_mono (by have := f.lt k; omega))
    intro j hj hnot
    simp only [Finset.mem_range] at hj hnot
    apply feedbackRoundTrip_netWorth_before_open hpoly hW hstrict δ P v
    exact hstrict (by omega)
  rw [← hprefix, Finset.sum_range_succ,
    feedbackRoundTrip_closed_sum hpoly hW hstrict δ P v k (f k) (le_refl _),
    feedbackRoundTrip_netWorth_open hpoly hW hstrict δ P v k]

/-- On each feedback day every plausible world values the concrete trader at least
`Wealth_k/2 - 1`.  Hence unbounded explicit feedback wealth produces genuine unbounded
trader upside, rather than merely an unbounded auxiliary sequence. -/
lemma feedbackTrader_netWorth_at_feedback_lower
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    {P : History} (hWdiv : DivergentWeighting W P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hδ0 : 0 ≤ (δ : ℝ)) (hδ : (δ : ℝ) ≤ 1 / 2)
    (v : PCWorld) (k : ℕ) :
    feedbackWealth (δ : ℝ) (fun j ↦ (W (f j)).denote P)
        (fun j ↦ (As (f j)).price P (f (j + 1)) -
          (As (f j)).price P (f j)) k / 2 - 1 ≤
      (feedbackTrader hpoly hW hstrict δ).netWorth P v (f k) := by
  let weights : ℕ → ℝ := fun j ↦ (W (f j)).denote P
  let returns : ℕ → ℝ := fun j ↦
    (As (f j)).price P (f (j + 1)) - (As (f j)).price P (f j)
  have hw : ∀ j, weights j ∈ Set.Icc (0 : ℝ) 1 := fun j ↦ hWdiv.1 (f j)
  have hr : ∀ j, returns j ∈ Set.Icc (-1 : ℝ) 1 := by
    intro j
    have ha := (As (f j)).abs_price_sub_price_le_magnitude P
      (f (j + 1)) (f j) (hP (f (j + 1))) (hP (f j))
    have hm := hmag (f j)
    rw [abs_le] at ha
    exact ⟨by dsimp [returns]; linarith, by dsimp [returns]; linarith⟩
  have hwealth : 0 ≤ feedbackWealth (δ : ℝ) weights returns k :=
    (feedbackWealth_pos hδ0 hδ hw hr k).le
  have hdiffAbs := (As (f k)).abs_value_sub_price_le_magnitude P v.payout (f k)
    (hpoly.terms_rank (f k))
    (fun φ ↦ by
      by_cases hφ : v.Holds φ
      · exact Or.inr (by simp [PCWorld.payout, hφ])
      · exact Or.inl (by simp [PCWorld.payout, hφ]))
    (hP (f k))
  have hdiff : -1 ≤
      (As (f k)).value P v.payout - (As (f k)).price P (f k) := by
    rw [abs_le] at hdiffAbs
    linarith [hmag (f k)]
  rw [feedbackTrader_netWorth_at_feedback hpoly hW hstrict δ P v k,
    feedbackBetaFeature_denote]
  change feedbackWealth (δ : ℝ) weights returns k / 2 - 1 ≤
    feedbackWealth (δ : ℝ) weights returns k - 1 +
      (δ : ℝ) * feedbackWealth (δ : ℝ) weights returns k * weights k *
        ((As (f k)).value P v.payout - (As (f k)).price P (f k))
  exact half_wealth_sub_one_le_with_live_position hδ0 hδ hwealth (hw k) hdiff

lemma feedbackTrader_plausible_not_bddAbove_of_wealth
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    {P : History} {DP : DeductiveProcess} (hWdiv : DivergentWeighting W P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hδ0 : 0 ≤ (δ : ℝ)) (hδ : (δ : ℝ) ≤ 1 / 2)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (hwealth : ¬ BddAbove (Set.range
      (feedbackWealth (δ : ℝ) (fun j ↦ (W (f j)).denote P)
        (fun j ↦ (As (f j)).price P (f (j + 1)) -
          (As (f j)).price P (f j))))) :
    ¬ BddAbove ((feedbackTrader hpoly hW hstrict δ).plausibleAssessments P DP) := by
  rw [not_bddAbove_iff] at hwealth ⊢
  intro B
  obtain ⟨wealth, ⟨k, rfl⟩, hk⟩ := hwealth (2 * (B + 1))
  obtain ⟨v, hv⟩ := hworld (f k)
  have hlower := feedbackTrader_netWorth_at_feedback_lower
    hpoly hW hstrict δ hWdiv hmag hP hδ0 hδ v k
  refine ⟨(feedbackTrader hpoly hW hstrict δ).netWorth P v (f k),
    ⟨f k, v, hv, rfl⟩, ?_⟩
  linarith

/-- The completed economic kernel: genuinely unbounded feedback wealth makes the
explicit sparse round-trip trader exploit the market, with the downside and upside both
proved from its emitted strategies.  Efficient computability is attached separately. -/
lemma feedbackTrader_exploits_of_wealth_unbounded
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ)
    {P : History} {DP : DeductiveProcess} (hWdiv : DivergentWeighting W P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hδ0 : 0 ≤ (δ : ℝ)) (hδ : (δ : ℝ) ≤ 1 / 2)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (hwealth : ¬ BddAbove (Set.range
      (feedbackWealth (δ : ℝ) (fun j ↦ (W (f j)).denote P)
        (fun j ↦ (As (f j)).price P (f (j + 1)) -
          (As (f j)).price P (f j))))) :
    (feedbackTrader hpoly hW hstrict δ).Exploits P DP := by
  exact ⟨feedbackTrader_plausible_bddBelow hpoly hW hstrict δ hWdiv hmag hP
      hδ0 hδ DP,
    feedbackTrader_plausible_not_bddAbove_of_wealth hpoly hW hstrict δ hWdiv hmag hP
      hδ0 hδ hworld hwealth⟩

/-- Non-vacuous end-to-end Kelly exploitation theorem.  A recurrent positive return
margin and divergent supported mass force the explicit trader's plausible assessments
unbounded above while its global loss remains bounded by one. -/
lemma feedbackTrader_exploits_of_frequently_positive_return
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ) (γ : ℝ)
    {P : History} {DP : DeductiveProcess} (hWdiv : DivergentWeighting W P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hδ0 : 0 < (δ : ℝ)) (hδ : (δ : ℝ) ≤ 1 / 2)
    (hgap : 2 * (δ : ℝ) < γ)
    (hmass : Tendsto (fun k ↦ ∑ i ∈ Finset.range k, (W (f i)).denote P)
      atTop atTop)
    (hfreq : ∃ᶠ k in atTop,
      γ * (∑ i ∈ Finset.range k, (W (f i)).denote P) ≤
        ∑ i ∈ Finset.range k, (W (f i)).denote P *
          ((As (f i)).price P (f (i + 1)) - (As (f i)).price P (f i)))
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n)) :
    (feedbackTrader hpoly hW hstrict δ).Exploits P DP := by
  have hw : ∀ i, (W (f i)).denote P ∈ Set.Icc (0 : ℝ) 1 :=
    fun i ↦ hWdiv.1 (f i)
  have hr : ∀ i,
      (As (f i)).price P (f (i + 1)) - (As (f i)).price P (f i) ∈
        Set.Icc (-1 : ℝ) 1 := by
    intro i
    have ha := (As (f i)).abs_price_sub_price_le_magnitude P
      (f (i + 1)) (f i) (hP (f (i + 1))) (hP (f i))
    have hm := hmag (f i)
    rw [abs_le] at ha
    exact ⟨by linarith, by linarith⟩
  apply feedbackTrader_exploits_of_wealth_unbounded hpoly hW hstrict δ hWdiv hmag hP
    hδ0.le hδ hworld
  exact feedbackWealth_not_bddAbove_of_frequently_positive_return
    hδ0 hδ hgap hw hr hmass hfreq

/-- Logical induction rules out the recurrent positive-return condition once the
structured syntax emitter has supplied the feedback trader's real token certificate.
Paper node: a step of `thm:wubaff` (App. `wubaff`). -/
theorem lic_not_frequently_positive_feedback_return
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f) (δ : ℚ) (γ : ℝ)
    {P : History} {DP : DeductiveProcess} [IsLogicalInductor P DP]
    (emit : FeedbackTraderEmission hpoly hW hstrict δ)
    (hWdiv : DivergentWeighting W P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hδ0 : 0 < (δ : ℝ)) (hδ : (δ : ℝ) ≤ 1 / 2)
    (hgap : 2 * (δ : ℝ) < γ)
    (hmass : Tendsto (fun k ↦ ∑ i ∈ Finset.range k, (W (f i)).denote P)
      atTop atTop)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n)) :
    ¬ ∃ᶠ k in atTop,
      γ * (∑ i ∈ Finset.range k, (W (f i)).denote P) ≤
        ∑ i ∈ Finset.range k, (W (f i)).denote P *
          ((As (f i)).price P (f (i + 1)) - (As (f i)).price P (f i)) := by
  intro hfreq
  have hexploit := feedbackTrader_exploits_of_frequently_positive_return
    hpoly hW hstrict δ γ hWdiv hmag hP hδ0 hδ hgap hmass hfreq hworld
  exact IsLogicalInductor.noExploit (P := P) (DP := DP)
    (feedbackTrader hpoly hW hstrict δ)
    (feedbackTrader_ecTok hpoly hW hstrict δ emit) hexploit

/-- Accuracy of the delayed feedback quote used by the Kelly proof. -/
def DeferralFeedbackAccurate (As : ℕ → AffineCombination) (truth : ℕ → ℝ)
    (P : History) (f : DeferralFunction) : Prop :=
  (fun k ↦ (As (f k)).price P (f (k + 1)) - truth (f k)) ≈ₙ (fun _ ↦ 0)

/-- Delayed feedback accuracy is invariant under simultaneous negation of the affine
sequence and its determined value stream. -/
lemma DeferralFeedbackAccurate.neg
    {As : ℕ → AffineCombination} {truth : ℕ → ℝ}
    {P : History} {f : DeferralFunction}
    (h : DeferralFeedbackAccurate As truth P f) :
    DeferralFeedbackAccurate (fun n ↦ (As n).neg) (fun n ↦ -truth n) P f := by
  have ht : Tendsto
      (fun k ↦ ((As (f k)).price P (f (k + 1)) - truth (f k)) - 0)
      atTop (𝓝 0) := h
  have hneg : Tendsto
      (fun k ↦ -((As (f k)).price P (f (k + 1)) - truth (f k)) - 0)
      atTop (𝓝 0) := by simpa using ht.neg
  change Tendsto
    (fun k ↦ (((As (f k)).neg).price P (f (k + 1)) - -truth (f k)) - 0)
    atTop (𝓝 0)
  apply Tendsto.congr' _ hneg
  filter_upwards [] with k
  rw [AffineCombination.neg_price]
  ring

/-- Exclusive finite-prefix sum used by the feedback-indexed Kelly proof. -/
noncomputable def feedbackPrefixSum (x : ℕ → ℝ) (k : ℕ) : ℝ :=
  ∑ i ∈ Finset.range k, x i

/-- Weighted average over the first `k` feedback indices.  This exclusive convention
matches `feedbackWealth`; its zero-mass branch is eventually irrelevant under divergence. -/
noncomputable def feedbackWeightedAverage (w x : ℕ → ℝ) (k : ℕ) : ℝ :=
  if feedbackPrefixSum w k = 0 then 0
  else feedbackPrefixSum (fun i ↦ w i * x i) k / feedbackPrefixSum w k

/-- Linearity of the feedback-clock weighted average.  The statement includes the
zero-mass branch, which is useful before divergence has supplied eventual positivity. -/
lemma feedbackWeightedAverage_sub (w x y : ℕ → ℝ) (k : ℕ) :
    feedbackWeightedAverage w (fun i ↦ x i - y i) k =
      feedbackWeightedAverage w x k - feedbackWeightedAverage w y k := by
  unfold feedbackWeightedAverage
  split <;> rename_i hmass
  · ring
  · have hnum :
        feedbackPrefixSum (fun i ↦ w i * (x i - y i)) k =
          feedbackPrefixSum (fun i ↦ w i * x i) k -
            feedbackPrefixSum (fun i ↦ w i * y i) k := by
      simp only [feedbackPrefixSum]
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro i _
      ring
    rw [hnum]
    field_simp

/-- Negation commutes with the feedback-clock weighted average, including at zero mass. -/
lemma feedbackWeightedAverage_neg (w x : ℕ → ℝ) (k : ℕ) :
    feedbackWeightedAverage w (fun i ↦ -x i) k =
      -feedbackWeightedAverage w x k := by
  unfold feedbackWeightedAverage
  split <;> rename_i hmass
  · ring
  · have hnum :
        feedbackPrefixSum (fun i ↦ w i * -x i) k =
          -feedbackPrefixSum (fun i ↦ w i * x i) k := by
      simp only [feedbackPrefixSum, ← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro i _
      ring
    rw [hnum]
    ring

/-- Reindex an all-day prefix along a strictly increasing feedback schedule.  Terms
outside the schedule image vanish by `hsupport`; `sum_bij_ne_zero` makes that fact
explicit instead of introducing a noncomputable global inverse for `f`. -/
lemma prefixSum_at_deferral_eq_feedbackPrefixSum
    {w : ℕ → ℝ} {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f)
    (hsupport : ∀ n, w n ≠ 0 → ∃ j, f j = n) (k : ℕ) :
    prefixSum w (f k) =
      feedbackPrefixSum (fun j ↦ w (f j)) (k + 1) := by
  change (∑ n ∈ Finset.range (f k + 1), w n) =
    ∑ j ∈ Finset.range (k + 1), w (f j)
  apply Finset.sum_bij_ne_zero
    (fun n _ hnz ↦ Classical.choose (hsupport n hnz))
  · intro n hn hnz
    have hpre := Classical.choose_spec (hsupport n hnz)
    simp only [Finset.mem_range] at hn ⊢
    have hnfk : n ≤ f k := by omega
    by_contra hj
    have hkj : k < Classical.choose (hsupport n hnz) := by omega
    have hlt := hstrict hkj
    rw [hpre] at hlt
    omega
  · intro n₁ hn₁ hnz₁ n₂ hn₂ hnz₂ hidx
    have hpre₁ := Classical.choose_spec (hsupport n₁ hnz₁)
    have hpre₂ := Classical.choose_spec (hsupport n₂ hnz₂)
    calc
      n₁ = f (Classical.choose (hsupport n₁ hnz₁)) := hpre₁.symm
      _ = f (Classical.choose (hsupport n₂ hnz₂)) := by rw [hidx]
      _ = n₂ := hpre₂
  · intro j hj hjnz
    refine ⟨f j, ?_, hjnz, ?_⟩
    · simp only [Finset.mem_range] at hj ⊢
      exact Nat.lt_succ_of_le (hstrict.monotone (Nat.le_of_lt_succ hj))
    · have hpre := Classical.choose_spec (hsupport (f j) hjnz)
      exact hstrict.injective hpre
  · intro n hn hnz
    have hpre := Classical.choose_spec (hsupport n hnz)
    rw [hpre]

/-- Divergent all-day mass remains divergent after reindexing onto the feedback clock,
provided every nonzero weight lies in the schedule image. -/
lemma feedbackPrefixSum_tendsto_atTop
    {W : ℕ → EF} {P : History} {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f)
    (hWdiv : DivergentWeighting W P)
    (hsupport : WeightingSupportedOnDeferralImage W P f) :
    Tendsto (feedbackPrefixSum (fun k ↦ (W (f k)).denote P)) atTop atTop := by
  let w : ℕ → ℝ := fun n ↦ (W n).denote P
  have hf : Tendsto f atTop atTop := by
    apply tendsto_atTop.2
    intro N
    filter_upwards [eventually_ge_atTop N] with k hk
    exact hk.trans (f.lt k).le
  have hall : Tendsto (fun k ↦ prefixSum w (f k)) atTop atTop := by
    exact hWdiv.2.comp hf
  apply tendsto_atTop.2
  intro B
  obtain ⟨K, hK⟩ := eventually_atTop.1 (tendsto_atTop.1 hall B)
  refine eventually_atTop.2 ⟨K + 1, fun k hk ↦ ?_⟩
  have hkpos : 1 ≤ k := by omega
  have hpred : K ≤ k - 1 := by omega
  have hlarge := hK (k - 1) hpred
  rw [prefixSum_at_deferral_eq_feedbackPrefixSum hstrict
    (by simpa only [w] using hsupport) (k - 1)] at hlarge
  simpa only [w, Nat.sub_add_cancel hkpos] using hlarge

/-- Exact support transfer at an arbitrary day after the first feedback opening.  The
all-day prefix is constant between consecutive image points of the strict schedule. -/
lemma prefixSum_eq_feedbackPrefixSum_stage
    {w : ℕ → ℝ} {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f)
    (hsupport : ∀ n, w n ≠ 0 → ∃ j, f j = n)
    {n : ℕ} (h0 : f 0 ≤ n) :
    prefixSum w n =
      feedbackPrefixSum (fun j ↦ w (f j)) (feedbackStage f n + 1) := by
  have hopen : f (feedbackStage f n) ≤ n := feedbackStage_open h0
  have hsmall : prefixSum w (f (feedbackStage f n)) = prefixSum w n := by
    change (∑ i ∈ Finset.range (f (feedbackStage f n) + 1), w i) =
      ∑ i ∈ Finset.range (n + 1), w i
    apply Finset.sum_subset (Finset.range_mono (by omega))
    intro i hin hnotSmall
    by_contra hi
    obtain ⟨j, hj⟩ := hsupport i hi
    have hfi : f j ≤ n := by
      simp only [Finset.mem_range] at hin
      omega
    have hjn : j ≤ n := (f.lt j).le.trans hfi
    have hjstage : j ≤ feedbackStage f n :=
      Nat.le_findGreatest (P := fun k ↦ f k ≤ n) hjn hfi
    have hford := hstrict.monotone hjstage
    simp only [Finset.mem_range, not_lt] at hnotSmall
    rw [hj] at hford
    omega
  rw [← hsmall]
  exact prefixSum_at_deferral_eq_feedbackPrefixSum hstrict hsupport
    (feedbackStage f n)

/-- Convergence on the sparse feedback clock transfers back to the paper's all-day
weighted average when the weighting has no mass off the schedule image. -/
lemma weightedAverage_supported_asympEq_zero_of_feedback
    {w x : ℕ → ℝ} {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f)
    (hsupport : ∀ n, w n ≠ 0 → ∃ j, f j = n)
    (hsparse : feedbackWeightedAverage (fun k ↦ w (f k))
      (fun k ↦ x (f k)) ≈ₙ (fun _ ↦ 0)) :
    weightedAverage w x ≈ₙ (fun _ ↦ 0) := by
  have hstage : Tendsto (fun n ↦ feedbackStage f n + 1) atTop atTop := by
    apply tendsto_atTop.2
    intro K
    filter_upwards [eventually_ge_atTop (f K)] with n hn
    have hKn : K ≤ n := (f.lt K).le.trans hn
    have hKstage : K ≤ feedbackStage f n :=
      Nat.le_findGreatest (P := fun k ↦ f k ≤ n) hKn hn
    omega
  have hcomp : Tendsto
      (fun n ↦ feedbackWeightedAverage (fun k ↦ w (f k))
        (fun k ↦ x (f k)) (feedbackStage f n + 1) - 0)
      atTop (𝓝 0) := hsparse.comp hstage
  apply Tendsto.congr' _ hcomp
  filter_upwards [eventually_ge_atTop (f 0)] with n hn
  have hden := prefixSum_eq_feedbackPrefixSum_stage hstrict hsupport hn
  have hnum := prefixSum_eq_feedbackPrefixSum_stage
    (w := fun i ↦ w i * x i) hstrict
    (fun i hi ↦ hsupport i (fun hwi ↦ hi (by
      change w i * x i = 0
      rw [hwi, zero_mul]))) hn
  change feedbackWeightedAverage (fun k ↦ w (f k)) (fun k ↦ x (f k))
      (feedbackStage f n + 1) - 0 = weightedAverage w x n - 0
  unfold weightedAverage feedbackWeightedAverage
  rw [hden]
  have hnum' :
      prefixSum (fun i ↦ w i * x i) n =
        feedbackPrefixSum (fun k ↦ w (f k) * x (f k))
          (feedbackStage f n + 1) := hnum
  rw [hnum']

/-- Weighted Cesàro transfer on the feedback clock: nonnegative divergent mass sends
every vanishing error stream to a vanishing weighted average.  This is the analytic step
which absorbs the finitely many early delayed-quote errors in Appendix `app:wubaff`. -/
lemma feedbackWeightedAverage_asympEq_zero
    {w e : ℕ → ℝ} (hw0 : ∀ i, 0 ≤ w i)
    (hmass : Tendsto (feedbackPrefixSum w) atTop atTop)
    (he : e ≈ₙ (fun _ ↦ 0)) :
    feedbackWeightedAverage w e ≈ₙ (fun _ ↦ 0) := by
  apply asympEq_iff_eventuallyWithin.2
  intro ε hε
  have hevent := asympEq_iff_eventuallyWithin.1 he (ε / 2) (by linarith)
  change ∀ᶠ i in atTop, |e i - 0| ≤ ε / 2 at hevent
  obtain ⟨N, hN⟩ := eventually_atTop.1 hevent
  let C : ℝ := ∑ i ∈ Finset.range N, |w i * e i|
  have hC0 : 0 ≤ C := Finset.sum_nonneg fun _ _ ↦ abs_nonneg _
  have hlarge : ∀ᶠ k in atTop, 2 * C / ε < feedbackPrefixSum w k :=
    hmass.eventually (eventually_gt_atTop (2 * C / ε))
  filter_upwards [hlarge, eventually_ge_atTop N] with k hkmass hkN
  have hmass0 : 0 < feedbackPrefixSum w k := by
    have hthreshold : 0 ≤ 2 * C / ε := div_nonneg (mul_nonneg (by norm_num) hC0) hε.le
    linarith
  have hsplitNum := Finset.sum_range_add_sum_Ico (fun i ↦ w i * e i) hkN
  have hsplitMass := Finset.sum_range_add_sum_Ico w hkN
  have hearly :
      |∑ i ∈ Finset.range N, w i * e i| ≤ C := by
    exact (Finset.abs_sum_le_sum_abs (s := Finset.range N) (f := fun i ↦ w i * e i))
  have htail :
      |∑ i ∈ Finset.Ico N k, w i * e i| ≤
        (ε / 2) * ∑ i ∈ Finset.Ico N k, w i := by
    calc
      |∑ i ∈ Finset.Ico N k, w i * e i| ≤
          ∑ i ∈ Finset.Ico N k, |w i * e i| :=
        Finset.abs_sum_le_sum_abs (s := Finset.Ico N k) (f := fun i ↦ w i * e i)
      _ ≤ ∑ i ∈ Finset.Ico N k, (ε / 2) * w i := by
        apply Finset.sum_le_sum
        intro i hi
        have hiN : N ≤ i := (Finset.mem_Ico.mp hi).1
        have hinear := hN i hiN
        simp only [sub_zero] at hinear
        rw [abs_mul, abs_of_nonneg (hw0 i)]
        nlinarith [mul_le_mul_of_nonneg_left hinear (hw0 i)]
      _ = (ε / 2) * ∑ i ∈ Finset.Ico N k, w i := by
        rw [Finset.mul_sum]
  have htailMass :
      (∑ i ∈ Finset.Ico N k, w i) ≤ feedbackPrefixSum w k := by
    have hearlyMass : 0 ≤ ∑ i ∈ Finset.range N, w i :=
      Finset.sum_nonneg fun i _ ↦ hw0 i
    change (∑ i ∈ Finset.range N, w i) +
      (∑ i ∈ Finset.Ico N k, w i) = feedbackPrefixSum w k at hsplitMass
    linarith
  have hnum :
      |feedbackPrefixSum (fun i ↦ w i * e i) k| ≤
        C + (ε / 2) * feedbackPrefixSum w k := by
    change (∑ i ∈ Finset.range N, w i * e i) +
      (∑ i ∈ Finset.Ico N k, w i * e i) =
        feedbackPrefixSum (fun i ↦ w i * e i) k at hsplitNum
    rw [← hsplitNum]
    calc
      |(∑ i ∈ Finset.range N, w i * e i) +
          ∑ i ∈ Finset.Ico N k, w i * e i| ≤
        |∑ i ∈ Finset.range N, w i * e i| +
          |∑ i ∈ Finset.Ico N k, w i * e i| := abs_add_le _ _
      _ ≤ C + (ε / 2) * ∑ i ∈ Finset.Ico N k, w i := add_le_add hearly htail
      _ ≤ C + (ε / 2) * feedbackPrefixSum w k := by
        gcongr
  have hCsmall : C < (ε / 2) * feedbackPrefixSum w k := by
    have := (div_lt_iff₀ hε).mp hkmass
    nlinarith
  change |feedbackWeightedAverage w e k - 0| ≤ ε
  rw [feedbackWeightedAverage, if_neg (ne_of_gt hmass0), sub_zero, abs_div,
    abs_of_pos hmass0]
  apply (div_le_iff₀ hmass0).2
  linarith

/-- One-sided sparse feedback theorem.  Delayed quote accuracy makes the weighted
future-price error vanish.  If the current weighted bias were recurrently negative,
their difference would give the explicit Kelly trader a recurrent positive return,
contradicting logical induction. -/
lemma feedbackWeightedBias_asympGE_zero
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f)
    {truth : ℕ → ℝ} {P : History} {DP : DeductiveProcess}
    [IsLogicalInductor P DP]
    (emit : FeedbackTraderEmissionFamily hpoly hW hstrict)
    (hWdiv : DivergentWeighting W P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hacc : DeferralFeedbackAccurate As truth P f)
    (hmass : Tendsto
      (feedbackPrefixSum (fun k ↦ (W (f k)).denote P)) atTop atTop)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n)) :
    feedbackWeightedAverage (fun k ↦ (W (f k)).denote P)
      (fun k ↦ (As (f k)).price P (f k) - truth (f k)) ≳ₙ
        (fun _ ↦ 0) := by
  let w : ℕ → ℝ := fun k ↦ (W (f k)).denote P
  let quoteError : ℕ → ℝ := fun k ↦
    (As (f k)).price P (f (k + 1)) - truth (f k)
  let bias : ℕ → ℝ := fun k ↦
    (As (f k)).price P (f k) - truth (f k)
  let returns : ℕ → ℝ := fun k ↦
    (As (f k)).price P (f (k + 1)) - (As (f k)).price P (f k)
  have hw0 : ∀ k, 0 ≤ w k := fun k ↦ (hWdiv.1 (f k)).1
  have hquote : feedbackWeightedAverage w quoteError ≈ₙ (fun _ ↦ 0) := by
    apply feedbackWeightedAverage_asympEq_zero hw0
      (by simpa only [w] using hmass)
    simpa only [quoteError] using hacc
  intro ε hε
  have hsmall : (0 : ℝ) < min (1 / 4) (ε / 8) :=
    lt_min (by norm_num) (by linarith)
  obtain ⟨δ, hδ0, hδsmall⟩ :
      ∃ δ : ℚ, (0 : ℝ) < δ ∧ (δ : ℝ) < min (1 / 4) (ε / 8) :=
    exists_rat_btwn hsmall
  have hδhalf : (δ : ℝ) ≤ 1 / 2 := by
    have := hδsmall.trans_le (min_le_left (1 / 4 : ℝ) (ε / 8))
    linarith
  have hgap : 2 * (δ : ℝ) < ε / 2 := by
    have := hδsmall.trans_le (min_le_right (1 / 4 : ℝ) (ε / 8))
    linarith
  have hnot := lic_not_frequently_positive_feedback_return
    hpoly hW hstrict δ (ε / 2) (emit.emit δ hδ0 hδhalf)
      hWdiv hmag hP hδ0 hδhalf hgap hmass hworld
  rw [Filter.not_frequently] at hnot
  have hquoteNear := asympEq_iff_eventuallyWithin.1 hquote (ε / 4) (by linarith)
  have hmassPos : ∀ᶠ k in atTop, 0 < feedbackPrefixSum w k :=
    (by simpa only [w] using
      hmass.eventually (eventually_gt_atTop (0 : ℝ)))
  filter_upwards [hnot, hquoteNear, hmassPos] with k hreturn hq hpos
  have hreturnRaw :
      feedbackPrefixSum (fun i ↦ w i * returns i) k <
        (ε / 2) * feedbackPrefixSum w k := by
    change ¬ ((ε / 2) * feedbackPrefixSum w k ≤
      feedbackPrefixSum (fun i ↦ w i * returns i) k) at hreturn
    exact lt_of_not_ge hreturn
  have hreturnAvg : feedbackWeightedAverage w returns k < ε / 2 := by
    rw [feedbackWeightedAverage, if_neg (ne_of_gt hpos)]
    exact (div_lt_iff₀ hpos).2 hreturnRaw
  have hdecomp :
      feedbackWeightedAverage w returns k =
        feedbackWeightedAverage w quoteError k -
          feedbackWeightedAverage w bias k := by
    have hpoint : returns = fun i ↦ quoteError i - bias i := by
      funext i
      simp only [returns, quoteError, bias]
      ring
    rw [hpoint, feedbackWeightedAverage_sub]
  have hqLower : -(ε / 4) ≤ feedbackWeightedAverage w quoteError k := by
    simp only [sub_zero] at hq
    linarith [abs_le.mp hq]
  have hbiasLower : -ε ≤ feedbackWeightedAverage w bias k := by
    rw [hdecomp] at hreturnAvg
    linarith
  change 0 ≤ feedbackWeightedAverage w bias k + ε
  linarith

/-- Two-sided sparse feedback unbiasedness.  The upper bound is the proved lower-bound
theorem applied to the explicit negated affine sequence, then transported back using
linearity of the feedback weighted average. -/
lemma feedbackWeightedBias_asympEq_zero
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W) {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f)
    {truth : ℕ → ℝ} {P : History} {DP : DeductiveProcess}
    [IsLogicalInductor P DP]
    (emit : FeedbackTraderEmissionSigns hpoly hW hstrict)
    (hWdiv : DivergentWeighting W P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hacc : DeferralFeedbackAccurate As truth P f)
    (hmass : Tendsto
      (feedbackPrefixSum (fun k ↦ (W (f k)).denote P)) atTop atTop)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n)) :
    feedbackWeightedAverage (fun k ↦ (W (f k)).denote P)
      (fun k ↦ (As (f k)).price P (f k) - truth (f k)) ≈ₙ
        (fun _ ↦ 0) := by
  let w : ℕ → ℝ := fun k ↦ (W (f k)).denote P
  let bias : ℕ → ℝ := fun k ↦
    (As (f k)).price P (f k) - truth (f k)
  have hlower : feedbackWeightedAverage w bias ≳ₙ (fun _ ↦ 0) := by
    simpa only [w, bias] using feedbackWeightedBias_asympGE_zero
      hpoly hW hstrict emit.positive hWdiv hmag hP hacc hmass hworld
  have hmagNeg : ∀ i, ((As i).neg).magnitude P ≤ 1 := by
    intro i
    rw [AffineCombination.neg_magnitude]
    exact hmag i
  have hnegLower : feedbackWeightedAverage w (fun k ↦ -bias k) ≳ₙ
      (fun _ ↦ 0) := by
    have h := feedbackWeightedBias_asympGE_zero hpoly.neg hW hstrict
      emit.negative hWdiv hmagNeg hP hacc.neg hmass hworld
    rw [show
      (fun k ↦ ((As (f k)).neg).price P (f k) - -truth (f k)) =
        (fun k ↦ -bias k) by
          funext k
          simp only [bias, AffineCombination.neg_price]
          ring] at h
    simpa only [w] using h
  have hupper : feedbackWeightedAverage w bias ≲ₙ (fun _ ↦ 0) := by
    intro ε hε
    have hbound := hnegLower ε hε
    filter_upwards [hbound] with k hk
    rw [feedbackWeightedAverage_neg] at hk
    simp only [zero_add]
    linarith
  rw [asympEq_iff_asympLE_asympGE]
  exact ⟨hupper, hlower⟩

/-- Conclusion-free sparse sequence used to obtain delayed feedback from affine
provability induction.  At day `f(k+1)` its diagonal price is exactly the delayed quote
error for `A_{f k}`; every completed-theory world values it at zero.  The polynomial
sequence and normalization data are the ledgered `M7-FEEDBACK-TRUTH` witness corresponding
to the paper's premise that `ThmValue(A_{f k})` is computable within `poly(f(k+1))`.
Paper node: `thm:wubaff` (App. `wubaff`), reused by `thm:wubexp`. -/
structure FeedbackTruthSequence
    (As : ℕ → AffineCombination) (truth : ℕ → ℝ)
    (P : History) (DP : DeductiveProcess) (f : DeferralFunction) where
  determined : DeterminedViaTheory As P DP truth
  sequence : ℕ → AffineCombination
  poly : PolySequence sequence
  bounded : BoundedAffinePrices sequence P
  magnitude : ∀ n, (sequence n).magnitude P ≤ 1
  zero_value : ∀ n (v : PCWorld), v.ConsistentWithTheory DP →
    (sequence n).value P v.payout = 0
  feedback_price : ∀ k,
    (sequence (f (k + 1))).price P (f (k + 1)) =
      (As (f k)).price P (f (k + 1)) - truth (f k)

/-- Affine provability induction converts the explicit sparse zero-valued sequence into
the delayed truth-price bridge needed by the feedback trader. -/
lemma FeedbackTruthSequence.accurate
    {As : ℕ → AffineCombination} {truth : ℕ → ℝ}
    {P : History} {DP : DeductiveProcess} {f : DeferralFunction}
    [IsLogicalInductor P DP]
    (bridge : FeedbackTruthSequence As truth P DP f)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n)) :
    DeferralFeedbackAccurate As truth P f := by
  have hlearn := bridge.poly.affine_provind_theory_eq P DP bridge.bounded
    ⟨1, bridge.magnitude⟩ hP hworld 0 bridge.zero_value
  apply asympEq_iff_eventuallyWithin.2
  intro ε hε
  have hevent := asympEq_iff_eventuallyWithin.1 hlearn ε hε
  change ∀ᶠ n in atTop, |(bridge.sequence n).price P n - 0| ≤ ε at hevent
  change ∀ᶠ k in atTop,
    |((As (f k)).price P (f (k + 1)) - truth (f k)) - 0| ≤ ε
  rw [eventually_atTop] at hevent ⊢
  obtain ⟨N, hN⟩ := hevent
  refine ⟨N, fun k hk ↦ ?_⟩
  have hindex : N ≤ f (k + 1) := hk.trans (by have := f.lt (k + 1); omega)
  have hnear := hN (f (k + 1)) hindex
  rw [bridge.feedback_price] at hnear
  exact hnear

/-- `thm:wubaff` (conditional on the two explicit representation boundaries).

For every divergent market-generated weighting supported on a strictly increasing
feedback schedule, the weighted affine bias converges to zero.  `emit` supplies real
token certificates for the concrete Kelly traders in both sign orientations, while
`bridge` supplies the conclusion-free sparse zero-valued affine sequence whose delayed
accuracy follows from affine provability induction.  These are precisely the ledgered
`M7-FEEDBACK-EMIT` and `M7-FEEDBACK-TRUTH` constructors; all economic, analytic,
support-reindexing, and sign-transfer arguments are proved here. -/
theorem lic_wubaff
    {As : ℕ → AffineCombination} (hpoly : PolySequence As)
    {W : ℕ → EF} (hW : PGenerableWeighting W)
    {P : History} {DP : DeductiveProcess} [IsLogicalInductor P DP]
    {truth : ℕ → ℝ} {f : DeferralFunction}
    (hstrict : StrictlyIncreasingDeferral f)
    (hsupport : WeightingSupportedOnDeferralImage W P f)
    (emit : FeedbackTraderEmissionSigns hpoly hW hstrict)
    (bridge : FeedbackTruthSequence As truth P DP f)
    (hWdiv : DivergentWeighting W P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n)) :
    weightedBias (fun i ↦ (W i).denote P)
      (fun i ↦ (As i).price P i) truth ≈ₙ (fun _ ↦ 0) := by
  let w : ℕ → ℝ := fun i ↦ (W i).denote P
  let bias : ℕ → ℝ := fun i ↦ (As i).price P i - truth i
  have hmass : Tendsto
      (feedbackPrefixSum (fun k ↦ (W (f k)).denote P)) atTop atTop :=
    feedbackPrefixSum_tendsto_atTop hstrict hWdiv hsupport
  have hacc : DeferralFeedbackAccurate As truth P f :=
    bridge.accurate hP hworld
  have hsparse : feedbackWeightedAverage (fun k ↦ w (f k))
      (fun k ↦ bias (f k)) ≈ₙ (fun _ ↦ 0) := by
    simpa only [w, bias] using feedbackWeightedBias_asympEq_zero
      hpoly hW hstrict emit hWdiv hmag hP hacc hmass hworld
  have hall : weightedAverage w bias ≈ₙ (fun _ ↦ 0) :=
    weightedAverage_supported_asympEq_zero_of_feedback hstrict
      (by simpa only [w] using hsupport) hsparse
  simpa only [weightedBias, w, bias] using hall

/-- Paper-facing `thm:wubaff` for an arbitrary `BCS`.  Its canonical positive rational
normalization feeds the unit-risk feedback trader above; the operational emitter and
truth bridge are requested only for that concrete normalized family, and the final scale
is cancelled from weighted-bias convergence. -/
theorem BoundedCombinationSequence.wubaff
    {As : ℕ → AffineCombination} {P : History} {DP : DeductiveProcess}
    [IsLogicalInductor P DP]
    (h : BoundedCombinationSequence As P)
    {W : ℕ → EF} (hW : PGenerableWeighting W)
    {truth : ℕ → ℝ} (hdet : DeterminedViaTheory As P DP truth)
    {f : DeferralFunction} (hstrict : StrictlyIncreasingDeferral f)
    (hsupport : WeightingSupportedOnDeferralImage W P f)
    (emit : FeedbackTraderEmissionSigns
      (h.poly.scaleRat h.unitNormalization.scale) hW hstrict)
    (bridge : FeedbackTruthSequence
      (fun n => (As n).scale (.const h.unitNormalization.scale))
      (fun n => (h.unitNormalization.scale : ℝ) * truth n) P DP f)
    (hWdiv : DivergentWeighting W P)
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n)) :
    weightedBias (fun i => (W i).denote P)
      (fun i => (As i).price P i) truth ≈ₙ (fun _ => 0) := by
  let q : ℚ := h.unitNormalization.scale
  have hq : 0 < (q : ℝ) := h.unitNormalization.scale_pos
  have hdetScaled : DeterminedViaTheory
      (fun n => (As n).scale (.const q)) P DP
      (fun n => (q : ℝ) * truth n) := by
    intro n v hv
    rw [AffineCombination.scale_value, EF.denote_const, hdet n v hv]
  let bridge' : FeedbackTruthSequence
      (fun n => (As n).scale (.const q))
      (fun n => (q : ℝ) * truth n) P DP f :=
    { bridge with determined := hdetScaled }
  have hs := lic_wubaff (h.poly.scaleRat q) hW hstrict hsupport emit bridge'
    hWdiv h.unitNormalization.magnitude_le_one hP hworld
  have hscaled : (fun n => (q : ℝ) *
      weightedBias (fun i => (W i).denote P)
        (fun i => (As i).price P i) truth n) ≈ₙ (fun _ => 0) := by
    have hs' : weightedBias (fun i => (W i).denote P)
        (fun i => (q : ℝ) * (As i).price P i)
        (fun i => (q : ℝ) * truth i) ≈ₙ (fun _ => 0) := by
      simpa only [q, AffineCombination.scale_price, EF.denote_const] using hs
    have heq : weightedBias (fun i => (W i).denote P)
        (fun i => (q : ℝ) * (As i).price P i)
        (fun i => (q : ℝ) * truth i) =
        fun n => (q : ℝ) * weightedBias (fun i => (W i).denote P)
          (fun i => (As i).price P i) truth n := by
      funext n
      exact weightedBias_const_mul _ _ _ _ _
    rwa [heq] at hs'
  exact asympEq_zero_of_const_mul_pos hq hscaled

/-- Exact conditional `thm:wub`, obtained by the paper's one-share specialization of
`thm:wubaff`.  `TheoryTruth` states that `truth` is the completed-theory truth stream;
the two feedback representation arguments are the same narrowly ledgered computational
constructors as in the affine theorem, specialized to `sentenceAffine φ`. -/
theorem lic_wub
    (P : History) (DP : DeductiveProcess) [IsLogicalInductor P DP]
    (φ : ℕ → Sentence) (hφ : PolySentenceCodes φ)
    (truth : ℕ → ℝ) (htruth : TheoryTruth φ DP truth)
    (W : ℕ → EF) (hW : PGenerableWeighting W)
    (hWdiv : DivergentWeighting W P)
    (f : DeferralFunction) (hstrict : StrictlyIncreasingDeferral f)
    (hsupport : WeightingSupportedOnDeferralImage W P f)
    (emit : FeedbackTraderEmissionSigns
      (sentenceAffine_polySequence φ hφ) hW hstrict)
    (bridge : FeedbackTruthSequence (sentenceAffine φ) truth P DP f)
    (hP : ∀ n ψ, 0 ≤ P n ψ ∧ P n ψ ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n)) :
    weightedBias (fun i ↦ (W i).denote P)
      (fun i ↦ P i (φ i)) truth ≈ₙ (fun _ ↦ 0) := by
  have hdet : DeterminedViaTheory (sentenceAffine φ) P DP truth := by
    intro n v hv
    simpa [sentenceAffine, AffineCombination.value] using htruth n v hv
  have hmag : ∀ i, (sentenceAffine φ i).magnitude P ≤ 1 := by
    intro i
    simp
  let bridge' : FeedbackTruthSequence (sentenceAffine φ) truth P DP f :=
    { bridge with determined := hdet }
  have h := lic_wubaff (sentenceAffine_polySequence φ hφ) hW hstrict
    hsupport emit bridge' hWdiv hmag hP hworld
  simpa only [sentenceAffine_price] using h

end AffineCombination

/-! ## Operational patient selector -/

/-- Monotone envelope of a possibly nonmonotone deferral function.  The paper only
requires `f n > n`, so its patient-selector construction must retain component `i`
through `max_{k ≤ i} f k`, not merely through `f i`. -/
def deferralEnvelope (f : DeferralFunction) : ℕ → ℕ
  | 0 => f 0
  | n + 1 => max (deferralEnvelope f n) (f (n + 1))

lemma deferral_le_envelope (f : DeferralFunction) (n : ℕ) :
    f n ≤ deferralEnvelope f n := by
  cases n with
  | zero => exact le_rfl
  | succ n => exact le_max_right _ _

lemma deferralEnvelope_mono (f : DeferralFunction) :
    Monotone (deferralEnvelope f) := by
  apply monotone_nat_of_le_succ
  intro n
  exact le_max_left _ _

lemma deferral_le_envelope_of_le (f : DeferralFunction) {i j : ℕ} (hij : i ≤ j) :
    f i ≤ deferralEnvelope f j :=
  (deferral_le_envelope f i).trans (deferralEnvelope_mono f hij)

lemma lt_deferralEnvelope (f : DeferralFunction) (n : ℕ) :
    n < deferralEnvelope f n :=
  (f.lt n).trans_le (deferral_le_envelope f n)

/-- A bounded operational clock for the two finite facts used by the Appendix
`app:prandaff` selector: whether component `i` is still before its envelope deadline or
not yet certified settled at stage `n`.

The clock is a type-(c) computation boundary, not an economic certificate.  Its emitted
bit is polynomially codeable; activity only decreases; every component is active through
its deadline and eventually becomes inactive; and inactivity certifies both deadline
passage and exact finite-stage settlement.  It contains no prices, weighting divergence,
bias, or pseudorandom-learning conclusion.  The concrete bounded universal evaluator and
finite-world checker which instantiate it are the ledgered `M7-PATIENT-CLOCK` witness. -/
structure PatientSettlementClock (As : ℕ → AffineCombination) (P : History)
    (DP : DeductiveProcess) (truth : ℕ → ℝ) (f : DeferralFunction) where
  active : ℕ → ℕ → Bool
  active_codes : PolyRatCodes (fun z ↦
    if active z.unpair.2 z.unpair.1 then (1 : ℚ) else 0)
  antitone : ∀ i n, active i (n + 1) = true → active i n = true
  active_through_envelope : ∀ i n, n ≤ deferralEnvelope f i → active i n = true
  eventually_inactive : ∀ i, ∃ N, ∀ n, N ≤ n → active i n = false
  settled_of_inactive : ∀ i n, active i n = false →
    deferralEnvelope f i < n ∧ ∀ v : PCWorld, v.ConsistentWith (DP.D n) →
      (As i).value P v.payout = truth i

def PatientSettlementClock.neg
    {As : ℕ → AffineCombination} {P : History} {DP : DeductiveProcess}
    {truth : ℕ → ℝ} {f : DeferralFunction}
    (clock : PatientSettlementClock As P DP truth f) :
    PatientSettlementClock (fun n ↦ (As n).neg) P DP (fun n ↦ -truth n) f :=
  { active := clock.active
    active_codes := clock.active_codes
    antitone := clock.antitone
    active_through_envelope := clock.active_through_envelope
    eventually_inactive := clock.eventually_inactive
    settled_of_inactive := by
      intro i n hinactive
      obtain ⟨hdeadline, hsettled⟩ := clock.settled_of_inactive i n hinactive
      refine ⟨hdeadline, fun v hv ↦ ?_⟩
      rw [AffineCombination.neg_value, hsettled v hv] }

/-- Boolean unresolved/deferred occupancy as a closed expressible constant. -/
def patientOccupancy {As : ℕ → AffineCombination} {P : History}
    {DP : DeductiveProcess} {truth : ℕ → ℝ} {f : DeferralFunction}
    (clock : PatientSettlementClock As P DP truth f) (i n : ℕ) : EF :=
  EF.const (if clock.active i n then 1 else 0)

/-- The continuous attempted weight used when the diagonal affine price is below `low`.
It is the paper's underpricing gate, before the patient-capital correction. -/
def patientUnderpriceAttempt (As : ℕ → AffineCombination) (low width : ℚ)
    (n : ℕ) : EF :=
  buyIndF ((As n).priceFeature n) low width

/-- The actual patient selector weighting.  The audited shared fractional recurrence
computes remaining capital from earlier attempted weights and their current clock
occupancy, then multiplies by today's underpricing attempt. -/
def patientUnderpriceWeight {As : ℕ → AffineCombination} {P : History}
    {DP : DeductiveProcess} {truth : ℕ → ℝ} {f : DeferralFunction}
    (clock : PatientSettlementClock As P DP truth f) (low width : ℚ)
    (n : ℕ) : EF :=
  EF.mul
    (ROIBudget.fractionalSharedFeatureWeight (patientOccupancy clock)
      (patientUnderpriceAttempt As low width) n)
    (patientUnderpriceAttempt As low width n)

lemma PatientSettlementClock.occupancy_polySeg
    {As : ℕ → AffineCombination} {P : History} {DP : DeductiveProcess}
    {truth : ℕ → ℝ} {f : DeferralFunction}
    (clock : PatientSettlementClock As P DP truth f) :
    PolySegStream (fun z ↦
      (patientOccupancy clock z.unpair.2 z.unpair.1).serialize) := by
  exact PolySegStream.ofTokenStream
    (PolyTokenStream.serialize_const_comp clock.active_codes)

lemma patientUnderpriceAttempt_polySeg {As : ℕ → AffineCombination}
    (hpoly : AffineCombination.PolySequence As) (low width : ℚ) :
    PolySegStream (fun n ↦ (patientUnderpriceAttempt As low width n).serialize) :=
  hpoly.gradualEntry_polySeg low width

lemma patientUnderpriceWeight_polySeg
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} {truth : ℕ → ℝ}
    {f : DeferralFunction} (clock : PatientSettlementClock As P DP truth f)
    (low width : ℚ) :
    PolySegStream (fun n ↦ (patientUnderpriceWeight clock low width n).serialize) := by
  have hattempt := patientUnderpriceAttempt_polySeg hpoly low width
  have hweight := ROIBudget.fractionalSharedFeatureWeight_polySeg
    (patientOccupancy clock) (patientUnderpriceAttempt As low width)
      hattempt clock.occupancy_polySeg
  exact PolySegStream.serialize_mul hweight hattempt

@[simp] theorem patientOccupancy_denote
    {As : ℕ → AffineCombination} {P : History} {DP : DeductiveProcess}
    {truth : ℕ → ℝ} {f : DeferralFunction}
    (clock : PatientSettlementClock As P DP truth f) (i n : ℕ) (V : History) :
    (patientOccupancy clock i n).denote V =
      if clock.active i n then 1 else 0 := by
  simp only [patientOccupancy, EF.denote_const]
  split <;> norm_num

lemma PatientSettlementClock.occupancy_decreasing
    {As : ℕ → AffineCombination} {P : History} {DP : DeductiveProcess}
    {truth : ℕ → ℝ} {f : DeferralFunction}
    (clock : PatientSettlementClock As P DP truth f) (V : History) :
    ROIBudget.DecreasingOccupancy
      (fun i n ↦ (patientOccupancy clock i n).denote V) := by
  refine { nonneg := ?_, le_one := ?_, antitone := ?_ }
  · intro i n
    simp only [patientOccupancy_denote]
    split <;> norm_num
  · intro i n
    simp only [patientOccupancy_denote]
    split <;> norm_num
  · intro i n
    simp only [patientOccupancy_denote]
    by_cases hnext : clock.active i (n + 1) = true
    · rw [if_pos hnext, if_pos (clock.antitone i n hnext)]
    · rw [if_neg hnext]
      positivity

lemma patientUnderpriceAttempt_rank_le {As : ℕ → AffineCombination}
    (hpoly : AffineCombination.PolySequence As) (low width : ℚ) (n : ℕ) :
    (patientUnderpriceAttempt As low width n).rank ≤ n :=
  hpoly.gradualEntry_rank_le low width n

lemma patientOccupancy_rank_le
    {As : ℕ → AffineCombination} {P : History} {DP : DeductiveProcess}
    {truth : ℕ → ℝ} {f : DeferralFunction}
    (clock : PatientSettlementClock As P DP truth f) (i n : ℕ) :
    (patientOccupancy clock i n).rank ≤ n := by
  simp [patientOccupancy]

lemma patientUnderpriceWeight_rank_le
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} {truth : ℕ → ℝ}
    {f : DeferralFunction} (clock : PatientSettlementClock As P DP truth f)
    (low width : ℚ) (n : ℕ) :
    (patientUnderpriceWeight clock low width n).rank ≤ n := by
  simp only [patientUnderpriceWeight, EF.rank]
  exact Nat.max_le.mpr ⟨
    ROIBudget.fractionalSharedFeatureWeight_rank_le
      (patientOccupancy clock) (patientUnderpriceAttempt As low width)
      (patientUnderpriceAttempt_rank_le hpoly low width)
      (fun i n _hin ↦ patientOccupancy_rank_le clock i n) n,
    patientUnderpriceAttempt_rank_le hpoly low width n⟩

lemma patientUnderpriceAttempt_closed {As : ℕ → AffineCombination}
    (hpoly : AffineCombination.PolySequence As) (low width : ℚ)
    (n : ℕ) (ρ : List ℝ) (V : History) :
    (patientUnderpriceAttempt As low width n).denoteWith ρ V =
      (patientUnderpriceAttempt As low width n).denote V :=
  hpoly.gradualEntry_closed low width n ρ V

lemma patientOccupancy_closed
    {As : ℕ → AffineCombination} {P : History} {DP : DeductiveProcess}
    {truth : ℕ → ℝ} {f : DeferralFunction}
    (clock : PatientSettlementClock As P DP truth f)
    (i n : ℕ) (ρ : List ℝ) (V : History) :
    (patientOccupancy clock i n).denoteWith ρ V =
      (patientOccupancy clock i n).denote V := by
  simp [patientOccupancy, EF.denote]

/-- Exact semantic form of the concrete selector weight. -/
lemma patientUnderpriceWeight_denote
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} {truth : ℕ → ℝ}
    {f : DeferralFunction} (clock : PatientSettlementClock As P DP truth f)
    (low width : ℚ) (V : History) (n : ℕ) :
    (patientUnderpriceWeight clock low width n).denote V =
      ROIBudget.fractionalWeight
          (fun i d ↦ (patientOccupancy clock i d).denote V)
          (fun i ↦ (patientUnderpriceAttempt As low width i).denote V) n *
        (patientUnderpriceAttempt As low width n).denote V := by
  simp only [patientUnderpriceWeight, EF.denote_mul, Pi.mul_apply]
  rw [ROIBudget.fractionalSharedFeatureWeight_denote
    (patientOccupancy clock) (patientUnderpriceAttempt As low width)
    (patientUnderpriceAttempt_closed hpoly low width)
    (patientOccupancy_closed clock)]

lemma patientUnderpriceAttempt_mem (As : ℕ → AffineCombination)
    (low width : ℚ) (V : History) (n : ℕ) :
    0 ≤ (patientUnderpriceAttempt As low width n).denote V ∧
      (patientUnderpriceAttempt As low width n).denote V ≤ 1 := by
  simpa only [patientUnderpriceAttempt] using
    buyIndF_mem ((As n).priceFeature n) low width V

/-- Every realized selector value lies in the weighting interval `[0,1]`. -/
lemma patientUnderpriceWeight_mem
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} {truth : ℕ → ℝ}
    {f : DeferralFunction} (clock : PatientSettlementClock As P DP truth f)
    (low width : ℚ) (V : History) (n : ℕ) :
    0 ≤ (patientUnderpriceWeight clock low width n).denote V ∧
      (patientUnderpriceWeight clock low width n).denote V ≤ 1 := by
  let O : ℕ → ℕ → ℝ := fun i d ↦ (patientOccupancy clock i d).denote V
  let α : ℕ → ℝ := fun i ↦ (patientUnderpriceAttempt As low width i).denote V
  have hocc : ROIBudget.DecreasingOccupancy O := clock.occupancy_decreasing V
  have hα0 : ∀ i, 0 ≤ α i := fun i ↦
    (patientUnderpriceAttempt_mem As low width V i).1
  have hα1 : ∀ i, α i ≤ 1 := fun i ↦
    (patientUnderpriceAttempt_mem As low width V i).2
  have hβ0 := ROIBudget.fractionalWeight_nonneg O α hocc hα0 hα1 n
  have hβ1 := ROIBudget.fractionalWeight_le_one O α hocc hα0 hα1 n
  rw [patientUnderpriceWeight_denote hpoly clock low width V n]
  change 0 ≤ ROIBudget.fractionalWeight O α n * α n ∧
    ROIBudget.fractionalWeight O α n * α n ≤ 1
  constructor
  · exact mul_nonneg hβ0 (hα0 n)
  · nlinarith [hα0 n, hα1 n]

lemma patientUnderpriceWeight_pos_imp_price_lt
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} {truth : ℕ → ℝ}
    {f : DeferralFunction} (clock : PatientSettlementClock As P DP truth f)
    (low width : ℚ) (hwidth : 0 < (width : ℝ)) (n : ℕ)
    (hpos : 0 < (patientUnderpriceWeight clock low width n).denote P) :
    (As n).price P n < (low : ℝ) + width := by
  let O : ℕ → ℕ → ℝ := fun i d ↦ (patientOccupancy clock i d).denote P
  let α : ℕ → ℝ := fun i ↦ (patientUnderpriceAttempt As low width i).denote P
  have hocc : ROIBudget.DecreasingOccupancy O := clock.occupancy_decreasing P
  have hα0 : ∀ i, 0 ≤ α i := fun i ↦
    (patientUnderpriceAttempt_mem As low width P i).1
  have hα1 : ∀ i, α i ≤ 1 := fun i ↦
    (patientUnderpriceAttempt_mem As low width P i).2
  have hβ0 := ROIBudget.fractionalWeight_nonneg O α hocc hα0 hα1 n
  rw [patientUnderpriceWeight_denote hpoly clock low width P n] at hpos
  have hattempt : 0 < α n := by
    change 0 < ROIBudget.fractionalWeight O α n * α n at hpos
    nlinarith [hα0 n]
  have hopen := buyIndF_pos_imp hwidth hattempt
  simpa only [α, patientUnderpriceAttempt,
    (As n).priceFeature_denote] using hopen

/-- The patient selector is a genuinely market-generated weighting with a uniform
polynomial segment emitter, legal rank, and closed semantics. -/
lemma patientUnderpriceWeight_pgenerable
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} {truth : ℕ → ℝ}
    {f : DeferralFunction} (clock : PatientSettlementClock As P DP truth f)
    (low width : ℚ) :
    PGenerableWeighting (patientUnderpriceWeight clock low width) :=
  { polySeg := patientUnderpriceWeight_polySeg hpoly clock low width
    rank_le := patientUnderpriceWeight_rank_le hpoly clock low width
    closed := by
      intro n ρ V
      simp only [patientUnderpriceWeight, EF.denoteWith, EF.denote_mul,
        Pi.mul_apply]
      rw [ROIBudget.fractionalSharedFeatureWeight_closed
        (patientOccupancy clock) (patientUnderpriceAttempt As low width)
        (patientUnderpriceAttempt_closed hpoly low width)
        (patientOccupancy_closed clock)]
      rw [patientUnderpriceAttempt_closed hpoly low width]
      }

/-- The selector is patient for the paper's original (possibly nonmonotone) deferral
function.  The proof uses the explicit monotone envelope: all launches in
`[n, f n]` are simultaneously charged at day `f n`, so the fractional capital
invariant bounds the whole window by one. -/
lemma patientUnderpriceWeight_deferralPatient
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} {truth : ℕ → ℝ}
    {f : DeferralFunction} (clock : PatientSettlementClock As P DP truth f)
    (low width : ℚ) :
    DeferralPatient f (patientUnderpriceWeight clock low width) P := by
  refine ⟨1, fun n ↦ ?_⟩
  let O : ℕ → ℕ → ℝ := fun i d ↦ (patientOccupancy clock i d).denote P
  let α : ℕ → ℝ := fun i ↦ (patientUnderpriceAttempt As low width i).denote P
  have hocc : ROIBudget.DecreasingOccupancy O := clock.occupancy_decreasing P
  have hα0 : ∀ i, 0 ≤ α i := fun i ↦
    (patientUnderpriceAttempt_mem As low width P i).1
  have hα1 : ∀ i, α i ≤ 1 := fun i ↦
    (patientUnderpriceAttempt_mem As low width P i).2
  have hfull : ∀ i ∈ Finset.Icc n (f n), i < f n → O i (f n) = 1 := by
    intro i hi _
    have hi' := Finset.mem_Icc.mp hi
    have hactive : clock.active i (f n) = true :=
      clock.active_through_envelope i (f n)
        (deferral_le_envelope_of_le f hi'.1)
    simp only [O, patientOccupancy_denote, hactive, if_true]
  calc
    ∑ i ∈ Finset.Icc n (f n),
        (patientUnderpriceWeight clock low width i).denote P =
        ∑ i ∈ Finset.Icc n (f n),
          ROIBudget.fractionalWeight O α i * α i := by
      apply Finset.sum_congr rfl
      intro i _
      rw [patientUnderpriceWeight_denote hpoly clock low width P i]
    _ ≤ 1 := ROIBudget.fractional_allocations_finset_le_one O α hocc hα0 hα1
      (Finset.Icc n (f n)) (f n)
      (fun _ hi ↦ (Finset.mem_Icc.mp hi).2) hfull

lemma patientUnderpriceWeight_prefixSum_eq_fractionalAllocationPrefix
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} {truth : ℕ → ℝ}
    {f : DeferralFunction} (clock : PatientSettlementClock As P DP truth f)
    (low width : ℚ) (n : ℕ) :
    prefixSum (fun i ↦ (patientUnderpriceWeight clock low width i).denote P) n =
      ROIBudget.fractionalAllocationPrefix
        (fun i d ↦ (patientOccupancy clock i d).denote P)
        (fun i ↦ (patientUnderpriceAttempt As low width i).denote P) n := by
  rw [prefixSum, ROIBudget.fractionalAllocationPrefix,
    Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i _
  rw [patientUnderpriceWeight_denote hpoly clock low width P i]
  rfl

/-- Recurrent full-strength underpricing makes the patient selector genuinely divergent.
This is the Appendix recycling argument: every old occupancy eventually vanishes, while
the audited fractional recurrence forces unbounded cumulative allocation whenever the
attempt stream is frequently one. -/
lemma patientUnderpriceWeight_divergent
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} {truth : ℕ → ℝ}
    {f : DeferralFunction} (clock : PatientSettlementClock As P DP truth f)
    (low width : ℚ) (hwidth : 0 < (width : ℝ))
    (hfreq : ∃ᶠ n in atTop, (As n).price P n < (low : ℝ)) :
    DivergentWeighting (patientUnderpriceWeight clock low width) P := by
  let O : ℕ → ℕ → ℝ := fun i d ↦ (patientOccupancy clock i d).denote P
  let α : ℕ → ℝ := fun i ↦ (patientUnderpriceAttempt As low width i).denote P
  have hocc : ROIBudget.DecreasingOccupancy O := clock.occupancy_decreasing P
  have hα0 : ∀ i, 0 ≤ α i := fun i ↦
    (patientUnderpriceAttempt_mem As low width P i).1
  have hα1 : ∀ i, α i ≤ 1 := fun i ↦
    (patientUnderpriceAttempt_mem As low width P i).2
  have hzero : ∀ i, α i = 0 ∨ ∃ N, ∀ n, N ≤ n → O i n = 0 := by
    intro i
    right
    obtain ⟨N, hN⟩ := clock.eventually_inactive i
    refine ⟨N, fun n hn ↦ ?_⟩
    simp only [O, patientOccupancy_denote, hN n hn, Bool.false_eq_true,
      ↓reduceIte]
  have hfreqOne : ∃ᶠ i in atTop, (1 : ℝ) ≤ α i := hfreq.mono (fun i hi ↦ by
    have hone : α i = 1 := by
      change (buyIndF ((As i).priceFeature i) low width).denote P = 1
      apply buyIndF_eq_one hwidth
      rwa [(As i).priceFeature_denote]
    rw [hone])
  have hunbounded : ¬ BddAbove (Set.range
      (ROIBudget.fractionalAllocationPrefix O α)) :=
    ROIBudget.fractionalAllocationPrefix_not_bddAbove_of_frequently
      O α hocc hzero hα0 hα1 (by norm_num) hfreqOne
  let s : ℕ → ℝ := fun n ↦
    prefixSum (fun i ↦ (patientUnderpriceWeight clock low width i).denote P) n
  have hsEq : ∀ n, s n = ROIBudget.fractionalAllocationPrefix O α n := by
    intro n
    simpa only [s, O, α] using
      patientUnderpriceWeight_prefixSum_eq_fractionalAllocationPrefix
        hpoly clock low width n
  have hsMono : Monotone s := by
    apply monotone_nat_of_le_succ
    intro n
    change prefixSum
        (fun i ↦ (patientUnderpriceWeight clock low width i).denote P) n ≤
      prefixSum
        (fun i ↦ (patientUnderpriceWeight clock low width i).denote P) (n + 1)
    rw [prefixSum_succ]
    exact le_add_of_nonneg_right
      (patientUnderpriceWeight_mem hpoly clock low width P (n + 1)).1
  refine ⟨fun n ↦ patientUnderpriceWeight_mem hpoly clock low width P n, ?_⟩
  change Tendsto s atTop atTop
  apply hsMono.tendsto_atTop_atTop
  intro b
  obtain ⟨y, ⟨n, rfl⟩, hby⟩ := (not_bddAbove_iff.mp hunbounded) b
  exact ⟨n, (le_of_lt hby).trans_eq (hsEq n).symm⟩

lemma DeferralPatient.mono_bound {f : DeferralFunction} {W : ℕ → EF} {P : History}
    (h : DeferralPatient f W P) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ n,
      ∑ i ∈ Finset.Icc n (f n), (W i).denote P ≤ C := by
  obtain ⟨C, hC⟩ := h
  refine ⟨max C 0, le_max_right _ _, fun n ↦ (hC n).trans (le_max_left _ _ )⟩

/-- The analytic contradiction at the heart of the recurring-unbiasedness route to
pseudorandom learning.  If normalized bias has `0` as a genuine subsequential limit and
the normalized truth average is asymptotically nonnegative, then the normalized market
average cannot remain below any fixed negative margin.

This theorem proves the crossing/limit argument explicitly.  Its hypotheses contain no
diagonal market conclusion and no selector weighting. -/
lemma not_eventually_weightedAverage_lt_of_limitPoint_bias
    (w market truth : ℕ → ℝ)
    (hden : ∀ᶠ n in atTop, 0 < prefixSum w n)
    (hbias : HasLimitPoint (weightedBias w market truth) 0)
    (htruth : (weightedAverage w truth) ≳ₙ (fun _ ↦ 0))
    (ε : ℝ) (hε : 0 < ε) :
    ¬ ∀ᶠ n in atTop, weightedAverage w market n < -ε := by
  intro hmarket
  obtain ⟨ψ, hψmono, hψbias⟩ := hbias.exists_subseq
  have htruthNear : ∀ᶠ n in atTop,
      -(ε / 4) ≤ weightedAverage w truth n := by
    have h := htruth (ε / 4) (by linarith)
    filter_upwards [h] with n hn
    linarith
  have hall : ∀ᶠ n in atTop,
      0 < prefixSum w n ∧
      -(ε / 4) ≤ weightedAverage w truth n ∧
      weightedAverage w market n < -ε := by
    filter_upwards [hden, htruthNear, hmarket] with n hn ht hm
    exact ⟨hn, ht, hm⟩
  have hallψ : ∀ᶠ k in atTop,
      0 < prefixSum w (ψ k) ∧
      -(ε / 4) ≤ weightedAverage w truth (ψ k) ∧
      weightedAverage w market (ψ k) < -ε :=
    hψmono.tendsto_atTop hall
  have hbiasNear : ∀ᶠ k in atTop,
      |weightedBias w market truth (ψ k)| < ε / 4 := by
    have h := Metric.tendsto_atTop.1 hψbias (ε / 4) (by linarith)
    obtain ⟨N, hN⟩ := h
    exact eventually_atTop.2 ⟨N, fun k hk ↦ by
      simpa [Real.dist_eq] using hN k hk⟩
  obtain ⟨N, hN⟩ := eventually_atTop.1 (hallψ.and hbiasNear)
  obtain ⟨hk, hb⟩ := hN N le_rfl
  rw [weightedBias_eq_market_sub_truth w market truth (ne_of_gt hk.1)] at hb
  rw [abs_lt] at hb
  linarith [hk.2.1, hk.2.2, hb.1, hb.2]

/-- Dual analytic contradiction: a nonpositive truth average and a zero bias limit point
rule out a persistently positive market average. -/
lemma not_eventually_weightedAverage_gt_of_limitPoint_bias
    (w market truth : ℕ → ℝ)
    (hden : ∀ᶠ n in atTop, 0 < prefixSum w n)
    (hbias : HasLimitPoint (weightedBias w market truth) 0)
    (htruth : (weightedAverage w truth) ≲ₙ (fun _ ↦ 0))
    (ε : ℝ) (hε : 0 < ε) :
    ¬ ∀ᶠ n in atTop, ε < weightedAverage w market n := by
  intro hmarket
  obtain ⟨ψ, hψmono, hψbias⟩ := hbias.exists_subseq
  have htruthNear : ∀ᶠ n in atTop,
      weightedAverage w truth n ≤ ε / 4 := by
    have h := htruth (ε / 4) (by linarith)
    simpa only [Pi.zero_apply, zero_add] using h
  have hall : ∀ᶠ n in atTop,
      0 < prefixSum w n ∧
      weightedAverage w truth n ≤ ε / 4 ∧
      ε < weightedAverage w market n := by
    filter_upwards [hden, htruthNear, hmarket] with n hn ht hm
    exact ⟨hn, ht, hm⟩
  have hallψ : ∀ᶠ k in atTop,
      0 < prefixSum w (ψ k) ∧
      weightedAverage w truth (ψ k) ≤ ε / 4 ∧
      ε < weightedAverage w market (ψ k) :=
    hψmono.tendsto_atTop hall
  have hbiasNear : ∀ᶠ k in atTop,
      |weightedBias w market truth (ψ k)| < ε / 4 := by
    have h := Metric.tendsto_atTop.1 hψbias (ε / 4) (by linarith)
    obtain ⟨N, hN⟩ := h
    exact eventually_atTop.2 ⟨N, fun k hk ↦ by
      simpa [Real.dist_eq] using hN k hk⟩
  obtain ⟨N, hN⟩ := eventually_atTop.1 (hallψ.and hbiasNear)
  obtain ⟨hk, hb⟩ := hN N le_rfl
  rw [weightedBias_eq_market_sub_truth w market truth (ne_of_gt hk.1)] at hb
  rw [abs_lt] at hb
  linarith [hk.2.1, hk.2.2, hb.1, hb.2]

/-! ## Paper-facing affine pseudorandomness branch -/

/-- The `≳ₙ 0` branch of `thm:prandaff`, conditional only on the two already disclosed
operational representation boundaries: historical maturity verification for arbitrary
legal weightings, and the settlement clock for the determined affine sequence.  The
proof constructs the Appendix selector, proves it P-generable/divergent/patient, obtains
its zero recurring-bias limit point, and derives the diagonal contradiction. -/
theorem AffineCombination.DeterminedViaTheory.lic_prandaff_above_of_historicalVerifiers
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} [IsLogicalInductor P DP]
    {truth : ℕ → ℝ} (hdet : AffineCombination.DeterminedViaTheory As P DP truth)
    (hbounded : BoundedAffinePrices As P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (f : DeferralFunction) (clock : PatientSettlementClock As P DP truth f)
    (hpseudo : PseudorandomAbove truth f P)
    (hverify : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable As hpoly W hWgen P DP)
    (hverifyNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable (fun n ↦ (As n).neg)
        hpoly.neg W hWgen P DP) :
    (fun n ↦ (As n).price P n) ≳ₙ (fun _ ↦ 0) := by
  intro ε hε
  by_contra hnotEventually
  rw [Filter.not_eventually] at hnotEventually
  have hfreqBad : ∃ᶠ n in atTop, (As n).price P n + ε < 0 :=
    hnotEventually.mono (fun n hn ↦ by
      exact lt_of_not_ge hn)
  obtain ⟨q, hq0, hqε⟩ : ∃ q : ℚ, (0 : ℝ) < q ∧ (q : ℝ) < ε / 2 :=
    exists_rat_btwn (half_pos hε)
  have hfreqLow : ∃ᶠ n in atTop,
      (As n).price P n < ((-2 * q : ℚ) : ℝ) :=
    hfreqBad.mono (fun n hn ↦ by
      push_cast
      linarith)
  let W : ℕ → EF := patientUnderpriceWeight clock (-2 * q) q
  have hWgen : PGenerableWeighting W := by
    simpa only [W] using
      patientUnderpriceWeight_pgenerable hpoly clock (-2 * q) q
  have hWdiv : DivergentWeighting W P := by
    simpa only [W] using
      patientUnderpriceWeight_divergent hpoly clock (-2 * q) q hq0 hfreqLow
  have hWpatient : DeferralPatient f W P := by
    simpa only [W] using
      patientUnderpriceWeight_deferralPatient hpoly clock (-2 * q) q
  let w : ℕ → ℝ := fun i ↦ (W i).denote P
  let market : ℕ → ℝ := fun i ↦ (As i).price P i
  have hw0 : ∀ i, 0 ≤ w i := fun i ↦ (hWdiv.1 i).1
  have hden : ∀ᶠ n in atTop, 0 < prefixSum w n := by
    simpa only [w] using hWdiv.eventually_prefixSum_pos
  obtain ⟨B, hB0, hB⟩ := hbounded
  have hsupport : ∀ i, 0 < w i → market i ∈ Icc (-B) (-(q : ℝ)) := by
    intro i hi
    have hpriceLow := patientUnderpriceWeight_pos_imp_price_lt
      hpoly clock (-2 * q) q hq0 i (by simpa only [w, W] using hi)
    constructor
    · have habs := hB i i
      exact (neg_le_neg habs).trans (neg_abs_le ((As i).price P i))
    · dsimp only [market]
      push_cast at hpriceLow
      linarith
  have hmarketBad : ∀ᶠ n in atTop,
      weightedAverage w market n < -((q : ℝ) / 2) := by
    filter_upwards [hden] with n hn
    have hmem := weightedAverage_mem_Icc_of_support hw0 hsupport hn
    linarith [hmem.2, hq0]
  have htruth : (weightedAverage w truth) ≳ₙ (fun _ ↦ 0) := by
    simpa only [w] using hpseudo W hWgen hWdiv hWpatient
  have hbias : HasLimitPoint (weightedBias w market truth) 0 := by
    simpa only [w, market] using
      hdet.recunbiasedaff_of_historicalVerifiers hpoly hWgen hWdiv hmag
        hworld hP (hverify W hWgen) (hverifyNeg W hWgen)
  exact (not_eventually_weightedAverage_lt_of_limitPoint_bias
    w market truth hden hbias htruth ((q : ℝ) / 2) (half_pos hq0)) hmarketBad

/-- The `≲ₙ 0` branch of `thm:prandaff`, obtained by applying the proved nonnegative
branch to the explicitly negated affine sequence. -/
theorem AffineCombination.DeterminedViaTheory.lic_prandaff_below_of_historicalVerifiers
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} [IsLogicalInductor P DP]
    {truth : ℕ → ℝ} (hdet : AffineCombination.DeterminedViaTheory As P DP truth)
    (hbounded : BoundedAffinePrices As P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (f : DeferralFunction) (clock : PatientSettlementClock As P DP truth f)
    (hpseudo : PseudorandomBelow truth f P)
    (hverifyNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable (fun n ↦ (As n).neg)
        hpoly.neg W hWgen P DP)
    (hverifyNegNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n ↦ ((As n).neg).neg) hpoly.neg.neg W hWgen P DP) :
    (fun n ↦ (As n).price P n) ≲ₙ (fun _ ↦ 0) := by
  have hboundedNeg : BoundedAffinePrices (fun n ↦ (As n).neg) P := by
    obtain ⟨B, hB0, hB⟩ := hbounded
    refine ⟨B, hB0, fun n m ↦ ?_⟩
    rw [AffineCombination.neg_price, abs_neg]
    exact hB n m
  have hmagNeg : ∀ i, ((As i).neg).magnitude P ≤ 1 := by
    intro i
    rw [AffineCombination.neg_magnitude]
    exact hmag i
  have haboveNeg := hdet.neg.lic_prandaff_above_of_historicalVerifiers
    hpoly.neg hboundedNeg hmagNeg hworld hP f clock.neg hpseudo.neg
      hverifyNeg hverifyNegNeg
  intro ε hε
  filter_upwards [haboveNeg ε hε] with n hn
  rw [AffineCombination.neg_price] at hn
  simp only [zero_add]
  linarith

/-- Exact two-sided `thm:prandaff`: pseudorandom completed-theory values force the
diagonal affine prices to converge asymptotically to zero.  The separate declarations
above retain the paper's one-sided variants. -/
theorem AffineCombination.DeterminedViaTheory.lic_prandaff_of_historicalVerifiers
    {As : ℕ → AffineCombination} (hpoly : AffineCombination.PolySequence As)
    {P : History} {DP : DeductiveProcess} [IsLogicalInductor P DP]
    {truth : ℕ → ℝ} (hdet : AffineCombination.DeterminedViaTheory As P DP truth)
    (hbounded : BoundedAffinePrices As P)
    (hmag : ∀ i, (As i).magnitude P ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (f : DeferralFunction) (clock : PatientSettlementClock As P DP truth f)
    (hpseudo : Pseudorandom truth f P)
    (hverify : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable As hpoly W hWgen P DP)
    (hverifyNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable (fun n ↦ (As n).neg)
        hpoly.neg W hWgen P DP)
    (hverifyNegNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n ↦ ((As n).neg).neg) hpoly.neg.neg W hWgen P DP) :
    (fun n ↦ (As n).price P n) ≈ₙ (fun _ ↦ 0) := by
  rw [asympEq_iff_asympLE_asympGE]
  exact ⟨
    hdet.lic_prandaff_below_of_historicalVerifiers hpoly hbounded hmag hworld hP
      f clock hpseudo.2 hverifyNeg hverifyNegNeg,
    hdet.lic_prandaff_above_of_historicalVerifiers hpoly hbounded hmag hworld hP
      f clock hpseudo.1 hverify hverifyNeg⟩

/-- Paper-facing nonnegative branch of `thm:prandaff` for an arbitrary `BCS`.
The patient clock and historical verifiers are formulated for the canonical normalized
family, and positive-scale cancellation restores the original diagonal prices. -/
theorem AffineCombination.BoundedCombinationSequence.prandaff_above
    {As : ℕ → AffineCombination} {P : History} {DP : DeductiveProcess}
    [IsLogicalInductor P DP]
    (h : AffineCombination.BoundedCombinationSequence As P)
    {truth : ℕ → ℝ}
    (hdet : AffineCombination.DeterminedViaTheory As P DP truth)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (f : DeferralFunction)
    (clock : PatientSettlementClock
      (fun n => (As n).scale (.const h.unitNormalization.scale)) P DP
      (fun n => (h.unitNormalization.scale : ℝ) * truth n) f)
    (hpseudo : PseudorandomAbove truth f P)
    (hverify : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n => (As n).scale (.const h.unitNormalization.scale))
        (h.poly.scaleRat h.unitNormalization.scale) W hWgen P DP)
    (hverifyNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n => ((As n).scale (.const h.unitNormalization.scale)).neg)
        (h.poly.scaleRat h.unitNormalization.scale).neg W hWgen P DP) :
    (fun n => (As n).price P n) ≳ₙ (fun _ => 0) := by
  let q : ℚ := h.unitNormalization.scale
  have hq : 0 < (q : ℝ) := h.unitNormalization.scale_pos
  have hdetScaled : AffineCombination.DeterminedViaTheory
      (fun n => (As n).scale (.const q)) P DP
      (fun n => (q : ℝ) * truth n) := by
    intro n v hv
    rw [AffineCombination.scale_value, EF.denote_const, hdet n v hv]
  have hs := hdetScaled.lic_prandaff_above_of_historicalVerifiers
    (h.poly.scaleRat q) ((h.boundedPrices hP).scaleRat q)
      h.unitNormalization.magnitude_le_one hworld hP f clock
      (hpseudo.const_mul_pos hq) hverify hverifyNeg
  have hscaled : (fun n => (q : ℝ) * (As n).price P n) ≳ₙ (fun _ => 0) := by
    simpa only [q, AffineCombination.scale_price, EF.denote_const] using hs
  exact asympGE_zero_of_const_mul_pos hq hscaled

/-- Paper-facing nonpositive branch of `thm:prandaff` for an arbitrary `BCS`. -/
theorem AffineCombination.BoundedCombinationSequence.prandaff_below
    {As : ℕ → AffineCombination} {P : History} {DP : DeductiveProcess}
    [IsLogicalInductor P DP]
    (h : AffineCombination.BoundedCombinationSequence As P)
    {truth : ℕ → ℝ}
    (hdet : AffineCombination.DeterminedViaTheory As P DP truth)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (f : DeferralFunction)
    (clock : PatientSettlementClock
      (fun n => (As n).scale (.const h.unitNormalization.scale)) P DP
      (fun n => (h.unitNormalization.scale : ℝ) * truth n) f)
    (hpseudo : PseudorandomBelow truth f P)
    (hverifyNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n => ((As n).scale (.const h.unitNormalization.scale)).neg)
        (h.poly.scaleRat h.unitNormalization.scale).neg W hWgen P DP)
    (hverifyNegNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n => (((As n).scale (.const h.unitNormalization.scale)).neg).neg)
        (h.poly.scaleRat h.unitNormalization.scale).neg.neg W hWgen P DP) :
    (fun n => (As n).price P n) ≲ₙ (fun _ => 0) := by
  let q : ℚ := h.unitNormalization.scale
  have hq : 0 < (q : ℝ) := h.unitNormalization.scale_pos
  have hdetScaled : AffineCombination.DeterminedViaTheory
      (fun n => (As n).scale (.const q)) P DP
      (fun n => (q : ℝ) * truth n) := by
    intro n v hv
    rw [AffineCombination.scale_value, EF.denote_const, hdet n v hv]
  have hs := hdetScaled.lic_prandaff_below_of_historicalVerifiers
    (h.poly.scaleRat q) ((h.boundedPrices hP).scaleRat q)
      h.unitNormalization.magnitude_le_one hworld hP f clock
      (hpseudo.const_mul_pos hq) hverifyNeg hverifyNegNeg
  have hscaled : (fun n => (q : ℝ) * (As n).price P n) ≲ₙ (fun _ => 0) := by
    simpa only [q, AffineCombination.scale_price, EF.denote_const] using hs
  exact asympLE_zero_of_const_mul_pos hq hscaled

/-- Exact two-sided paper `thm:prandaff` for every bounded-combination sequence. -/
theorem AffineCombination.BoundedCombinationSequence.prandaff
    {As : ℕ → AffineCombination} {P : History} {DP : DeductiveProcess}
    [IsLogicalInductor P DP]
    (h : AffineCombination.BoundedCombinationSequence As P)
    {truth : ℕ → ℝ}
    (hdet : AffineCombination.DeterminedViaTheory As P DP truth)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (hP : ∀ n φ, 0 ≤ P n φ ∧ P n φ ≤ 1)
    (f : DeferralFunction)
    (clock : PatientSettlementClock
      (fun n => (As n).scale (.const h.unitNormalization.scale)) P DP
      (fun n => (h.unitNormalization.scale : ℝ) * truth n) f)
    (hpseudo : Pseudorandom truth f P)
    (hverify : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n => (As n).scale (.const h.unitNormalization.scale))
        (h.poly.scaleRat h.unitNormalization.scale) W hWgen P DP)
    (hverifyNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n => ((As n).scale (.const h.unitNormalization.scale)).neg)
        (h.poly.scaleRat h.unitNormalization.scale).neg W hWgen P DP)
    (hverifyNegNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n => (((As n).scale (.const h.unitNormalization.scale)).neg).neg)
        (h.poly.scaleRat h.unitNormalization.scale).neg.neg W hWgen P DP) :
    (fun n => (As n).price P n) ≈ₙ (fun _ => 0) := by
  rw [asympEq_iff_asympLE_asympGE]
  exact ⟨h.prandaff_below hdet hworld hP f clock hpseudo.2 hverifyNeg hverifyNegNeg,
    h.prandaff_above hdet hworld hP f clock hpseudo.1 hverify hverifyNeg⟩

/-! ## Sentence-frequency specializations -/

theorem AffineCombination.TheoryTruth.sentenceMinusFeature_determined
    {φ : ℕ → Sentence} {P : History} {DP : DeductiveProcess}
    {truth : ℕ → ℝ} (htruth : AffineCombination.TheoryTruth φ DP truth)
    {p : ℕ → ℚ} {pFeature : ℕ → EF}
    (hp : GeneratedRatFeature P p pFeature) :
    AffineCombination.DeterminedViaTheory
      (AffineCombination.sentenceMinusFeature φ pFeature) P DP
      (fun n ↦ truth n - (p n : ℝ)) := by
  intro n v hv
  rw [AffineCombination.sentenceMinusFeature_value, hp.denote n, htruth n v hv]

/-- `thm:prand`, varied-pseudorandom-above branch. -/
theorem lic_learning_varied_pseudorandom_above
    (P : History) (DP : DeductiveProcess) [IsLogicalInductor P DP]
    (φ : ℕ → Sentence) (p : ℕ → ℚ) (pFeature : ℕ → EF)
    (hφ : PolySentenceCodes φ) (hp : GeneratedRatFeature P p pFeature)
    (truth : ℕ → ℝ) (htruth : AffineCombination.TheoryTruth φ DP truth)
    (hP : ∀ n ψ, 0 ≤ P n ψ ∧ P n ψ ≤ 1)
    (hpProb : ∀ n, 0 ≤ (p n : ℝ) ∧ (p n : ℝ) ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (f : DeferralFunction)
    (clock : PatientSettlementClock
      (AffineCombination.sentenceMinusFeature φ pFeature) P DP
      (fun n ↦ truth n - (p n : ℝ)) f)
    (hpseudo : VariedPseudorandomAbove truth p f P)
    (hverify : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (AffineCombination.sentenceMinusFeature φ pFeature)
        (AffineCombination.sentenceMinusFeature_polySequence φ pFeature hφ hp)
        W hWgen P DP)
    (hverifyNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n ↦ (AffineCombination.sentenceMinusFeature φ pFeature n).neg)
        (AffineCombination.sentenceMinusFeature_polySequence φ pFeature hφ hp).neg
        W hWgen P DP) :
    (fun n ↦ P n (φ n)) ≳ₙ (fun n ↦ (p n : ℝ)) := by
  have hdet := htruth.sentenceMinusFeature_determined hp
  have hres := hdet.lic_prandaff_above_of_historicalVerifiers
    (AffineCombination.sentenceMinusFeature_polySequence φ pFeature hφ hp)
    (AffineCombination.sentenceMinusFeature_bounded φ pFeature hp hP hpProb)
    (fun i ↦ by simp) hworld hP f clock hpseudo hverify hverifyNeg
  intro ε hε
  filter_upwards [hres ε hε] with n hn
  rw [AffineCombination.sentenceMinusFeature_price, hp.denote n] at hn
  linarith

/-- `thm:prand`, varied-pseudorandom-below branch. -/
theorem lic_learning_varied_pseudorandom_below
    (P : History) (DP : DeductiveProcess) [IsLogicalInductor P DP]
    (φ : ℕ → Sentence) (p : ℕ → ℚ) (pFeature : ℕ → EF)
    (hφ : PolySentenceCodes φ) (hp : GeneratedRatFeature P p pFeature)
    (truth : ℕ → ℝ) (htruth : AffineCombination.TheoryTruth φ DP truth)
    (hP : ∀ n ψ, 0 ≤ P n ψ ∧ P n ψ ≤ 1)
    (hpProb : ∀ n, 0 ≤ (p n : ℝ) ∧ (p n : ℝ) ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (f : DeferralFunction)
    (clock : PatientSettlementClock
      (AffineCombination.sentenceMinusFeature φ pFeature) P DP
      (fun n ↦ truth n - (p n : ℝ)) f)
    (hpseudo : VariedPseudorandomBelow truth p f P)
    (hverifyNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n ↦ (AffineCombination.sentenceMinusFeature φ pFeature n).neg)
        (AffineCombination.sentenceMinusFeature_polySequence φ pFeature hφ hp).neg
        W hWgen P DP)
    (hverifyNegNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n ↦ ((AffineCombination.sentenceMinusFeature φ pFeature n).neg).neg)
        (AffineCombination.sentenceMinusFeature_polySequence φ pFeature hφ hp).neg.neg
        W hWgen P DP) :
    (fun n ↦ P n (φ n)) ≲ₙ (fun n ↦ (p n : ℝ)) := by
  have hdet := htruth.sentenceMinusFeature_determined hp
  have hres := hdet.lic_prandaff_below_of_historicalVerifiers
    (AffineCombination.sentenceMinusFeature_polySequence φ pFeature hφ hp)
    (AffineCombination.sentenceMinusFeature_bounded φ pFeature hp hP hpProb)
    (fun i ↦ by simp) hworld hP f clock hpseudo hverifyNeg hverifyNegNeg
  intro ε hε
  filter_upwards [hres ε hε] with n hn
  rw [AffineCombination.sentenceMinusFeature_price, hp.denote n] at hn
  linarith

/-- Exact two-sided `thm:prand`. -/
theorem lic_learning_varied_pseudorandom
    (P : History) (DP : DeductiveProcess) [IsLogicalInductor P DP]
    (φ : ℕ → Sentence) (p : ℕ → ℚ) (pFeature : ℕ → EF)
    (hφ : PolySentenceCodes φ) (hp : GeneratedRatFeature P p pFeature)
    (truth : ℕ → ℝ) (htruth : AffineCombination.TheoryTruth φ DP truth)
    (hP : ∀ n ψ, 0 ≤ P n ψ ∧ P n ψ ≤ 1)
    (hpProb : ∀ n, 0 ≤ (p n : ℝ) ∧ (p n : ℝ) ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (f : DeferralFunction)
    (clock : PatientSettlementClock
      (AffineCombination.sentenceMinusFeature φ pFeature) P DP
      (fun n ↦ truth n - (p n : ℝ)) f)
    (hpseudo : VariedPseudorandom truth p f P)
    (hverify : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (AffineCombination.sentenceMinusFeature φ pFeature)
        (AffineCombination.sentenceMinusFeature_polySequence φ pFeature hφ hp)
        W hWgen P DP)
    (hverifyNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n ↦ (AffineCombination.sentenceMinusFeature φ pFeature n).neg)
        (AffineCombination.sentenceMinusFeature_polySequence φ pFeature hφ hp).neg
        W hWgen P DP)
    (hverifyNegNeg : ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n ↦ ((AffineCombination.sentenceMinusFeature φ pFeature n).neg).neg)
        (AffineCombination.sentenceMinusFeature_polySequence φ pFeature hφ hp).neg.neg
        W hWgen P DP) :
    (fun n ↦ P n (φ n)) ≈ₙ (fun n ↦ (p n : ℝ)) := by
  have hdet := htruth.sentenceMinusFeature_determined hp
  have hres := hdet.lic_prandaff_of_historicalVerifiers
    (AffineCombination.sentenceMinusFeature_polySequence φ pFeature hφ hp)
    (AffineCombination.sentenceMinusFeature_bounded φ pFeature hp hP hpProb)
    (fun i ↦ by simp) hworld hP f clock hpseudo hverify hverifyNeg hverifyNegNeg
  show Tendsto (fun n ↦ P n (φ n) - (p n : ℝ)) atTop (𝓝 0)
  simpa only [AsympEq, AffineCombination.sentenceMinusFeature_price,
    hp.denote, sub_zero] using hres

/-! ## Fixed-frequency rational squeeze -/

/-- The operational evidence needed to apply the rational-target `prand` theorem at
every rational `q ∈ [0,1]` used by the `thm:benford` squeeze.

This is an explicit type-(c) representation boundary, not a learning certificate.  Its
fields provide only settlement clocks and executable historical verifiers for the
centered affine family and its two negations.  In particular, it contains no price bound,
pseudorandomness premise, convergence statement, or conclusion of `thm:benford`.
`M7-HIST-EVALN` and `M7-PATIENT-CLOCK` are the ledgered concrete witnesses. -/
structure PseudorandomFrequencyInfrastructure
    (P : History) (DP : DeductiveProcess) (φ : ℕ → Sentence)
    (hφ : PolySentenceCodes φ) (truth : ℕ → ℝ) (f : DeferralFunction) where
  clock : ∀ (q : ℚ), 0 ≤ (q : ℝ) → (q : ℝ) ≤ 1 →
    PatientSettlementClock
      (AffineCombination.sentenceMinusFeature φ
        (AffineCombination.constantRatFeature q)) P DP
      (fun n ↦ truth n - (q : ℝ)) f
  verify : ∀ (q : ℚ), 0 ≤ (q : ℝ) → (q : ℝ) ≤ 1 →
    ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (AffineCombination.sentenceMinusFeature φ
          (AffineCombination.constantRatFeature q))
        (AffineCombination.sentenceMinusFeature_polySequence φ
          (AffineCombination.constantRatFeature q) hφ
          (AffineCombination.constantRatFeature_generated P q))
        W hWgen P DP
  verifyNeg : ∀ (q : ℚ), 0 ≤ (q : ℝ) → (q : ℝ) ≤ 1 →
    ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n ↦ (AffineCombination.sentenceMinusFeature φ
          (AffineCombination.constantRatFeature q) n).neg)
        (AffineCombination.sentenceMinusFeature_polySequence φ
          (AffineCombination.constantRatFeature q) hφ
          (AffineCombination.constantRatFeature_generated P q)).neg
        W hWgen P DP
  verifyNegNeg : ∀ (q : ℚ), 0 ≤ (q : ℝ) → (q : ℝ) ≤ 1 →
    ∀ (W : ℕ → EF) (hWgen : PGenerableWeighting W),
      AffineCombination.BiasRunHistoricallyVerifiable
        (fun n ↦ ((AffineCombination.sentenceMinusFeature φ
          (AffineCombination.constantRatFeature q) n).neg).neg)
        (AffineCombination.sentenceMinusFeature_polySequence φ
          (AffineCombination.constantRatFeature q) hφ
          (AffineCombination.constantRatFeature_generated P q)).neg.neg
        W hWgen P DP

/-- Lower half of `thm:benford`.  The target frequency `p` remains real.  At `p = 0`
the market's pointwise probability lower bound suffices; otherwise a rational
`max(0, p-ε/2) < q < p` is learned via `prand`. -/
theorem lic_learning_pseudorandom_frequency_above
    (P : History) (DP : DeductiveProcess) [IsLogicalInductor P DP]
    (φ : ℕ → Sentence) (hφ : PolySentenceCodes φ)
    (truth : ℕ → ℝ) (htruth : AffineCombination.TheoryTruth φ DP truth)
    (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1)
    (hP : ∀ n ψ, 0 ≤ P n ψ ∧ P n ψ ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (f : DeferralFunction) (hpseudo : PseudorandomFrequency truth p f P)
    (hinfra : PseudorandomFrequencyInfrastructure P DP φ hφ truth f) :
    (fun n ↦ P n (φ n)) ≳ₙ (fun _ ↦ p) := by
  intro ε hε
  by_cases hp0 : p = 0
  · subst p
    exact Filter.Eventually.of_forall fun n ↦ by
      have hn := (hP n (φ n)).1
      linarith
  · have hp_pos : 0 < p := lt_of_le_of_ne hp.1 (Ne.symm hp0)
    have hinterval : max 0 (p - ε / 2) < p :=
      max_lt hp_pos (by linarith)
    obtain ⟨q, hqlow, hqhigh⟩ := exists_rat_btwn hinterval
    have hq0 : 0 ≤ (q : ℝ) :=
      (le_max_left 0 (p - ε / 2)).trans hqlow.le
    have hq1 : (q : ℝ) ≤ 1 := hqhigh.le.trans hp.2
    have hlearn := lic_learning_varied_pseudorandom_above
      P DP φ (fun _ ↦ q) (AffineCombination.constantRatFeature q)
      hφ (AffineCombination.constantRatFeature_generated P q)
      truth htruth hP (fun _ ↦ ⟨hq0, hq1⟩) hworld f
      (hinfra.clock q hq0 hq1) (hpseudo.variedAbove_of_lt q hqhigh)
      (hinfra.verify q hq0 hq1) (hinfra.verifyNeg q hq0 hq1)
    filter_upwards [hlearn (ε / 2) (by linarith)] with n hn
    have hqnear : p - ε / 2 < (q : ℝ) :=
      (le_max_right 0 (p - ε / 2)).trans_lt hqlow
    linarith

/-- Upper half of `thm:benford`.  At `p = 1` the market's pointwise probability upper
bound suffices; otherwise the proof learns a rational
`p < q < min(1, p+ε/2)` via the below branch of `prand`. -/
theorem lic_learning_pseudorandom_frequency_below
    (P : History) (DP : DeductiveProcess) [IsLogicalInductor P DP]
    (φ : ℕ → Sentence) (hφ : PolySentenceCodes φ)
    (truth : ℕ → ℝ) (htruth : AffineCombination.TheoryTruth φ DP truth)
    (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1)
    (hP : ∀ n ψ, 0 ≤ P n ψ ∧ P n ψ ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (f : DeferralFunction) (hpseudo : PseudorandomFrequency truth p f P)
    (hinfra : PseudorandomFrequencyInfrastructure P DP φ hφ truth f) :
    (fun n ↦ P n (φ n)) ≲ₙ (fun _ ↦ p) := by
  intro ε hε
  by_cases hp1 : p = 1
  · subst p
    exact Filter.Eventually.of_forall fun n ↦ by
      have hn := (hP n (φ n)).2
      linarith
  · have hp_lt_one : p < 1 := lt_of_le_of_ne hp.2 hp1
    have hinterval : p < min 1 (p + ε / 2) :=
      lt_min hp_lt_one (by linarith)
    obtain ⟨q, hqlow, hqhigh⟩ := exists_rat_btwn hinterval
    have hq0 : 0 ≤ (q : ℝ) := hp.1.trans hqlow.le
    have hq1 : (q : ℝ) ≤ 1 :=
      hqhigh.le.trans (min_le_left 1 (p + ε / 2))
    have hlearn := lic_learning_varied_pseudorandom_below
      P DP φ (fun _ ↦ q) (AffineCombination.constantRatFeature q)
      hφ (AffineCombination.constantRatFeature_generated P q)
      truth htruth hP (fun _ ↦ ⟨hq0, hq1⟩) hworld f
      (hinfra.clock q hq0 hq1) (hpseudo.variedBelow_of_lt q hqlow)
      (hinfra.verifyNeg q hq0 hq1) (hinfra.verifyNegNeg q hq0 hq1)
    filter_upwards [hlearn (ε / 2) (by linarith)] with n hn
    have hqnear : (q : ℝ) < p + ε / 2 :=
      hqhigh.trans_le (min_le_right 1 (p + ε / 2))
    linarith

/-- Exact `thm:benford`: an efficiently emittable sentence sequence whose completed-
theory truth stream is pseudorandom with real frequency `p` is learned at frequency `p`.
The proof is the paper's rational squeeze, with explicit endpoint cases. -/
theorem lic_learning_pseudorandom_frequency
    (P : History) (DP : DeductiveProcess) [IsLogicalInductor P DP]
    (φ : ℕ → Sentence) (hφ : PolySentenceCodes φ)
    (truth : ℕ → ℝ) (htruth : AffineCombination.TheoryTruth φ DP truth)
    (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1)
    (hP : ∀ n ψ, 0 ≤ P n ψ ∧ P n ψ ≤ 1)
    (hworld : ∀ n, ∃ v : PCWorld, v.ConsistentWith (DP.D n))
    (f : DeferralFunction) (hpseudo : PseudorandomFrequency truth p f P)
    (hinfra : PseudorandomFrequencyInfrastructure P DP φ hφ truth f) :
    (fun n ↦ P n (φ n)) ≈ₙ (fun _ ↦ p) := by
  rw [asympEq_iff_asympLE_asympGE]
  exact ⟨
    lic_learning_pseudorandom_frequency_below P DP φ hφ truth htruth p hp hP hworld
      f hpseudo hinfra,
    lic_learning_pseudorandom_frequency_above P DP φ hφ truth htruth p hp hP hworld
      f hpseudo hinfra⟩

